---
import { Icon } from "astro-icon/components";

interface Item {
  label: string;
  done?: boolean;
}

interface Props {
  title: string;
  items: Item[];
  tone?: "paper" | "yellow" | "cyan" | "green";
  class?: string;
}

const { title, items, tone = "paper", class: className = "" } = Astro.props;

const toneClass = {
  paper: "bg-paper",
  yellow: "bg-yellow text-on-accent",
  cyan: "bg-cyan text-on-accent",
  green: "bg-green text-on-accent",
}[tone];

const done = items.filter((i) => i.done).length;
const pct = items.length ? Math.round((done / items.length) * 100) : 0;
---

<aside
  class:list={[
    "border-ink shadow-neo-md border-[3px] p-5",
    toneClass,
    className,
  ]}
>
  <h3 class="heading mb-4 text-xl uppercase">{title}</h3>
  <ul class="space-y-2.5">
    {
      items.map((item) => (
        <li class="flex items-start gap-3">
          <span
            class:list={[
              "border-ink mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center border-[2px]",
              item.done ? "bg-ink text-bg" : "bg-paper",
            ]}
          >
            {item.done && <Icon name="lucide:check" class="h-3 w-3" />}
          </span>
          <span
            class:list={[
              "text-sm leading-snug font-medium",
              item.done && "line-through opacity-70",
            ]}
          >
            {item.label}
          </span>
        </li>
      ))
    }
  </ul>
  <div class="mt-5">
    <div class="mb-1.5 flex justify-between text-xs font-bold uppercase">
      <span>Progress</span>
      <span>{pct}%</span>
    </div>
    <div class="border-ink bg-paper h-3 border-[2px]">
      <div class="bg-ink h-full" style={`width:${pct}%`}></div>
    </div>
  </div>
</aside>
