---
type Tone =
  | "bg"
  | "paper"
  | "yellow"
  | "pink"
  | "cyan"
  | "green"
  | "blue"
  | "ink";

interface Props {
  tone?: Tone;
  dense?: boolean;
  bordered?: boolean;
  class?: string;
}

const {
  tone = "bg",
  dense = false,
  bordered = false,
  class: className = "",
} = Astro.props;

const toneClass: Record<Tone, string> = {
  bg: "bg-bg",
  paper: "bg-paper",
  yellow: "bg-yellow text-on-accent",
  pink: "bg-pink text-on-accent",
  cyan: "bg-cyan text-on-accent",
  green: "bg-green text-on-accent",
  blue: "bg-blue text-on-deep",
  ink: "bg-ink text-bg",
};

const borderClass = bordered ? "border-y-[3px] border-ink" : "";
---

<section
  class:list={["relative w-full", toneClass[tone], borderClass, className]}
>
  <div
    class:list={[
      "pointer-events-none absolute inset-0 opacity-[0.12]",
      dense ? "halftone-dense" : "halftone",
    ]}
    aria-hidden="true"
  >
  </div>
  <div class="relative">
    <slot />
  </div>
</section>
