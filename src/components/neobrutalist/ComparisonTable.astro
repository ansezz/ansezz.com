---
import { Icon } from "astro-icon/components";

interface Column {
  label: string;
  tone?: "yellow" | "pink" | "cyan" | "green" | "blue" | "red";
}

interface Row {
  icon?: string;
  label: string;
  cells: (string | boolean)[];
}

interface Props {
  columns: Column[];
  rows: Row[];
  class?: string;
}

const { columns, rows, class: className = "" } = Astro.props;

const toneClass: Record<string, string> = {
  yellow: "bg-yellow text-on-accent",
  pink: "bg-pink text-on-accent",
  cyan: "bg-cyan text-on-accent",
  green: "bg-green text-on-accent",
  blue: "bg-blue text-on-deep",
  red: "bg-red text-on-accent",
};
---

<div
  class:list={[
    "border-ink shadow-neo-md bg-paper overflow-x-auto border-[3px]",
    className,
  ]}
>
  <table class="w-full border-collapse">
    <thead>
      <tr>
        <th
          class="border-ink border-r-[3px] border-b-[3px] p-3 text-left text-xs uppercase"
        >
          &nbsp;
        </th>
        {
          columns.map((col) => (
            <th
              class:list={[
                "border-ink border-r-[3px] border-b-[3px] p-3 text-left text-sm font-black uppercase last:border-r-0",
                toneClass[col.tone ?? "yellow"],
              ]}
            >
              {col.label}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row, i) => (
          <tr class={i % 2 ? "bg-bg" : "bg-paper"}>
            <th class="border-ink border-r-[3px] border-b-[2px] p-3 text-left font-bold last:border-b-0">
              <span class="inline-flex items-center gap-2">
                {row.icon && <Icon name={row.icon} class="h-4 w-4" />}
                {row.label}
              </span>
            </th>
            {row.cells.map((cell) => (
              <td class="border-ink border-r-[3px] border-b-[2px] p-3 text-sm last:border-r-0">
                {typeof cell === "boolean" ? (
                  cell ? (
                    <Icon name="lucide:check" class="text-ink h-5 w-5" />
                  ) : (
                    <Icon name="lucide:x" class="text-ink/40 h-5 w-5" />
                  )
                ) : (
                  cell
                )}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
