---
interface Props {
  label?: string;
  scrollOnMobile?: boolean;
  sticky?: boolean;
  class?: string;
}

const {
  label,
  scrollOnMobile = true,
  sticky = false,
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    sticky
      ? "bg-bg/95 border-ink sticky top-[64px] z-30 border-y-[2px] py-3"
      : "",
    className,
  ]}
>
  {
    label && (
      <p class="mono mb-2 text-xs font-bold tracking-widest uppercase opacity-60">
        {label}
      </p>
    )
  }
  <ul
    class:list={[
      "flex gap-2",
      scrollOnMobile
        ? "tag-row-scroll -mx-5 overflow-x-auto px-5 sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0"
        : "flex-wrap",
    ]}
  >
    <slot />
  </ul>
</div>
