---
import { externalLinkAttrs } from "@/lib/links";

type Tone =
  | "paper"
  | "yellow"
  | "pink"
  | "cyan"
  | "green"
  | "red"
  | "blue"
  | "purple"
  | "ink";
type Size = "sm" | "md";

interface Props {
  tone?: Tone;
  size?: Size;
  href?: string;
  active?: boolean;
  class?: string;
  /** Keep on one line. True for scrolling pill rows, false for wrapping lists. */
  nowrap?: boolean;
}

const {
  tone = "paper",
  size = "md",
  href,
  active = false,
  class: className = "",
  nowrap = true,
} = Astro.props;

const toneClass: Record<Tone, string> = {
  paper: "bg-paper text-ink",
  yellow: "bg-yellow text-on-accent",
  pink: "bg-pink text-on-accent",
  cyan: "bg-cyan text-on-accent",
  green: "bg-green text-on-accent",
  red: "bg-red text-on-accent",
  blue: "bg-blue text-on-deep",
  purple: "bg-purple text-on-deep",
  ink: "bg-ink text-bg",
};

const sizeClass: Record<Size, string> = {
  sm: "px-2.5 py-1 text-xs",
  md: "px-3.5 py-1.5 text-sm",
};

const Tag = href ? "a" : "span";
const externalAttrs = href ? externalLinkAttrs(href) : {};
---

<Tag
  href={href}
  {...externalAttrs}
  class:list={[
    "border-ink inline-flex max-w-full items-center rounded-full border-[2px] font-bold tracking-wide uppercase",
    nowrap ? "whitespace-nowrap" : "text-left",
    toneClass[tone],
    sizeClass[size],
    href
      ? "shadow-neo-sm hover:shadow-neo-md transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
      : "",
    active ? "shadow-neo-md -translate-x-0.5 -translate-y-0.5" : "",
    className,
  ]}
>
  <slot />
</Tag>
