---
import { externalLinkAttrs } from "@/lib/links";

type Tone =
  | "paper"
  | "yellow"
  | "pink"
  | "blue"
  | "cyan"
  | "green"
  | "red"
  | "purple"
  | "ink";
type Shadow = "sm" | "md" | "lg" | "xl";
type ElementTag = "div" | "article" | "section" | "a" | "li";

interface KnownProps {
  tone?: Tone;
  shadow?: Shadow;
  hover?: boolean;
  tilt?: number;
  as?: ElementTag;
  href?: string;
  class?: string;
  ariaLabel?: string;
}

/** Anything beyond KnownProps (id, data-*, aria-*) is forwarded to the root. */
export interface Props extends KnownProps {
  [key: string]: unknown;
}

// Cast through KnownProps — the index signature would otherwise widen every
// destructured value to `unknown`.
const {
  tone = "paper",
  shadow = "md",
  hover = false,
  tilt = 0,
  as = "div",
  href,
  class: className = "",
  ariaLabel,
  ...rest
} = Astro.props as KnownProps & Record<string, unknown>;
const externalAttrs = href ? externalLinkAttrs(href) : {};

const toneClass: Record<Tone, string> = {
  paper: "bg-paper text-ink",
  yellow: "bg-yellow text-on-accent",
  pink: "bg-pink text-on-accent",
  blue: "bg-blue text-on-deep",
  cyan: "bg-cyan text-on-accent",
  green: "bg-green text-on-accent",
  red: "bg-red text-on-accent",
  purple: "bg-purple text-on-deep",
  ink: "bg-ink text-bg",
};

const shadowClass: Record<Shadow, string> = {
  sm: "shadow-neo-sm",
  md: "shadow-neo-md",
  lg: "shadow-neo-lg",
  xl: "shadow-neo-xl",
};

const hoverClass = hover
  ? "transition-all duration-150 hover:-translate-x-1 hover:-translate-y-1 hover:shadow-neo-lg"
  : "";

const Tag = href ? "a" : as;
const style = tilt ? `transform: rotate(${tilt}deg);` : undefined;
---

<Tag
  {...rest}
  href={href}
  {...externalAttrs}
  aria-label={ariaLabel}
  class:list={[
    "border-ink block rounded-[4px] border-[3px] p-6 md:p-7",
    toneClass[tone],
    shadowClass[shadow],
    hoverClass,
    className,
  ]}
  style={style}
>
  <slot />
</Tag>
