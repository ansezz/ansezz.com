---
interface Props {
  label?: string;
  available?: boolean;
  class?: string;
}

const {
  label = "Open to new work",
  available = true,
  class: className = "",
} = Astro.props;

const dotColor = available ? "bg-green" : "bg-red";
---

<span
  class:list={[
    "border-ink bg-paper shadow-neo-xs inline-flex max-w-full items-center gap-2.5 rounded-full border-[2px] px-3.5 py-1.5 text-left text-xs font-bold tracking-wide uppercase",
    className,
  ]}
>
  <span class="relative inline-flex h-2.5 w-2.5 shrink-0">
    <span
      class:list={["neo-pulse-dot absolute inset-0 rounded-full", dotColor]}
      aria-hidden="true"></span>
    <span
      class:list={[
        "border-ink relative inline-flex h-2.5 w-2.5 rounded-full border-[1.5px]",
        dotColor,
      ]}></span>
  </span>
  {label}
</span>
