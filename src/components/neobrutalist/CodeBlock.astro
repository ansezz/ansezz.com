---
import { codeToHtml } from "shiki";

interface Props {
  code: string;
  lang?: string;
  filename?: string;
}

const { code, lang = "ts", filename } = Astro.props;

const html = await codeToHtml(code, {
  lang,
  theme: "github-dark",
});
---

<figure class="relative">
  <span
    class="border-ink bg-yellow absolute -top-3 left-4 z-10 inline-flex items-center border-[2px] px-2 py-0.5 text-xs font-bold tracking-wider uppercase"
  >
    {filename ?? lang}
  </span>
  <div
    class="border-ink shadow-neo-md overflow-x-auto rounded-[4px] border-[3px] bg-[#24292e]"
  >
    <div class="mono p-4 text-sm [&_pre]:!bg-transparent" set:html={html} />
  </div>
</figure>
