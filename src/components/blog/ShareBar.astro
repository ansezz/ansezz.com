---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  url: string;
  class?: string;
  vertical?: boolean;
  label?: string;
}

const {
  title,
  url,
  class: className = "",
  vertical = false,
  label = "Share this post",
} = Astro.props;

const encoded = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const channels = [
  {
    name: "X",
    href: `https://x.com/intent/tweet?url=${encoded}&text=${encodedTitle}`,
    icon: "lucide:twitter",
    hover: "hover:bg-cyan",
  },
  {
    name: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encoded}`,
    icon: "lucide:linkedin",
    hover: "hover:bg-blue hover:text-paper",
  },
  {
    name: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encoded}`,
    icon: "lucide:facebook",
    hover: "hover:bg-blue hover:text-paper",
  },
  {
    name: "WhatsApp",
    href: `https://wa.me/?text=${encodedTitle}%20${encoded}`,
    icon: "lucide:message-circle",
    hover: "hover:bg-green",
  },
  {
    name: "Reddit",
    href: `https://www.reddit.com/submit?url=${encoded}&title=${encodedTitle}`,
    icon: "lucide:message-square",
    hover: "hover:bg-red hover:text-paper",
  },
  {
    name: "Hacker News",
    href: `https://news.ycombinator.com/submitlink?u=${encoded}&t=${encodedTitle}`,
    icon: "lucide:newspaper",
    hover: "hover:bg-yellow",
  },
  {
    name: "Email",
    href: `mailto:?subject=${encodedTitle}&body=${encoded}`,
    icon: "lucide:mail",
    hover: "hover:bg-purple hover:text-paper",
  },
];
---

<div
  class:list={[
    "flex items-center gap-2",
    vertical ? "flex-col" : "flex-wrap",
    className,
  ]}
  data-share-bar
  data-share-url={url}
  data-share-title={title}
>
  <p class="mono text-[10px] font-bold tracking-widest uppercase opacity-60">
    ▸ {label}
  </p>
  {
    channels.map((c) => (
      <a
        href={c.href}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[
          "border-ink bg-paper shadow-neo-xs hover:shadow-neo-sm inline-flex h-9 w-9 items-center justify-center rounded-[4px] border-[2.5px] transition-all hover:-translate-x-0.5 hover:-translate-y-0.5",
          c.hover,
        ]}
        aria-label={`Share on ${c.name}`}
        title={`Share on ${c.name}`}
      >
        <Icon name={c.icon} class="h-4 w-4" />
      </a>
    ))
  }
  <button
    type="button"
    data-copy-link
    class="border-ink bg-paper shadow-neo-xs hover:shadow-neo-sm hover:bg-pink hover:text-paper inline-flex h-9 w-9 items-center justify-center rounded-[4px] border-[2.5px] transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
    aria-label="Copy link to clipboard"
    title="Copy link"
    data-copy-label="Copy link"
    data-copied-label="Copied!"
  >
    <Icon name="lucide:link" class="h-4 w-4" data-copy-icon />
    <span class="sr-only" data-copy-status>Copy link</span>
  </button>
</div>

<script>
  import "@/scripts/share-bar";
</script>
