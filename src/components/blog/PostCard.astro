---
import type { CollectionEntry } from "astro:content";
import PostMeta from "@/components/blog/PostMeta.astro";
import { getReadingTime } from "@/lib/reading";
import { CATEGORY_LABEL, CATEGORY_TONE } from "@/consts";

type Tone = "paper" | "yellow" | "pink" | "cyan" | "green" | "red" | "purple";

interface Props {
  post: CollectionEntry<"blog">;
  eager?: boolean;
  tone?: Tone;
}

const { post, eager = false, tone = "paper" } = Astro.props;
const rt = getReadingTime(post.body, post);
const hero = post.data.heroImage;

const toneClass: Record<Tone, string> = {
  paper: "bg-paper text-ink",
  yellow: "bg-yellow text-ink",
  pink: "bg-pink text-ink",
  cyan: "bg-cyan text-ink",
  green: "bg-green text-ink",
  red: "bg-red text-ink",
  purple: "bg-purple text-paper",
};

const placeholderBg: Record<string, string> = {
  red: "bg-red",
  cyan: "bg-cyan",
  green: "bg-green",
  blue: "bg-blue text-paper",
  yellow: "bg-yellow",
  pink: "bg-pink",
};
const phTone = CATEGORY_TONE[post.data.category];
const phClass = placeholderBg[phTone] ?? "bg-yellow";
const initials = CATEGORY_LABEL[post.data.category].slice(0, 2).toUpperCase();
---

<a
  href={`/blog/${post.id}/`}
  data-neo-hover
  class:list={[
    "group border-ink shadow-neo-md hover:shadow-neo-lg flex h-full flex-col overflow-hidden rounded-[4px] border-[3px] transition-all duration-150 hover:-translate-x-1 hover:-translate-y-1",
    toneClass[tone],
  ]}
>
  {
    hero ? (
      <div class="border-ink bg-ink relative aspect-[5/4] overflow-hidden border-b-[3px]">
        <img
          src={hero.url}
          alt={hero.alt}
          width="800"
          height="640"
          loading={eager ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={eager ? "high" : "auto"}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      </div>
    ) : (
      <div
        class:list={[
          "border-ink relative flex aspect-[5/4] items-center justify-center overflow-hidden border-b-[3px]",
          phClass,
        ]}
        aria-hidden="true"
      >
        <span class="halftone pointer-events-none absolute inset-0 opacity-30" />
        <span class="mono bg-ink text-bg absolute top-3 left-3 px-2 py-0.5 text-[10px] font-bold tracking-widest uppercase">
          {CATEGORY_LABEL[post.data.category]}
        </span>
        <span class="display text-[clamp(3.5rem,9vw,5.5rem)] leading-none drop-shadow-[3px_3px_0_var(--color-ink)]">
          {initials}
        </span>
      </div>
    )
  }
  <div class="flex flex-1 flex-col gap-3 p-5">
    <PostMeta
      date={post.data.publishDate}
      updatedDate={post.data.updatedDate}
      category={post.data.category}
      readingTime={rt}
      showTime={false}
      linkCategory={false}
    />
    <h3 class="heading text-xl leading-tight md:text-2xl">
      {post.data.title}
    </h3>
    <p class="line-clamp-3 text-sm leading-snug opacity-80">
      {post.data.description}
    </p>
    <p
      class="mt-auto pt-2 text-sm font-bold decoration-[3px] underline-offset-4 group-hover:underline"
    >
      Read post →
    </p>
  </div>
</a>
