---
// Sticky reading progress bar shown under header on article pages.
---

<div
  class="bg-bg/0 pointer-events-none sticky top-[56px] z-30 h-[3px] w-full md:top-[60px]"
  aria-hidden="true"
>
  <div
    id="reading-progress-bar"
    class="bg-pink h-full origin-left transition-[width] duration-100 ease-out"
    style="width: 0%;"
  >
  </div>
</div>

<script>
  import "@/scripts/reading-progress";
</script>
