---
import RobotMascot from "@/components/neobrutalist/RobotMascot.astro";
import NeoButton from "@/components/neobrutalist/NeoButton.astro";
import SocialButton from "@/components/neobrutalist/SocialButton.astro";
import AvailabilityBadge from "@/components/neobrutalist/AvailabilityBadge.astro";
import { Icon } from "astro-icon/components";
import { OWNER, SITE } from "@/consts";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<aside
  class:list={[
    "border-ink bg-paper shadow-neo-md relative rounded-[4px] border-[3px] p-6 md:p-10",
    className,
  ]}
>
  <div class="grid items-start gap-6 md:grid-cols-[160px_1fr] md:gap-10">
    <div
      class="relative flex justify-center md:justify-start"
      data-mascot="author"
    >
      <RobotMascot tone="yellow" size={160} />
    </div>
    <div>
      <p
        class="mono text-accent-text mb-2 text-xs font-bold tracking-widest uppercase"
      >
        ▸ Written by
      </p>
      <h2 class="display mb-1 text-3xl md:text-4xl">{OWNER.NAME}</h2>
      <p class="text-ink/80 mb-4 text-base leading-snug md:text-lg">
        {OWNER.TAGLINE}
      </p>

      <div class="mb-5">
        <AvailabilityBadge />
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <NeoButton href="/contact/" variant="primary" size="md">
          <Icon name="lucide:mail" class="h-4 w-4" />
          Let's work together
        </NeoButton>
        <NeoButton href="/about/" variant="secondary" size="md">
          More about me →
        </NeoButton>

        <span class="ml-1 inline-flex items-center gap-2">
          <SocialButton
            href="https://github.com/ansezz"
            icon="lucide:github"
            label="GitHub"
            tone="paper"
            size="sm"
          />
          <SocialButton
            href="https://linkedin.com/in/ansezz"
            icon="lucide:linkedin"
            label="LinkedIn"
            tone="cyan"
            size="sm"
          />
          <SocialButton
            href={`mailto:${SITE.EMAIL}`}
            icon="lucide:mail"
            label="Email"
            tone="yellow"
            size="sm"
          />
        </span>
      </div>
    </div>
  </div>
</aside>
