---
import HalftoneSection from "@/components/neobrutalist/HalftoneSection.astro";
import { STATS } from "@/consts";
---

<HalftoneSection tone="pink" bordered class="py-12 md:py-16">
  <div class="mx-auto grid max-w-5xl grid-cols-2 gap-6 px-5 md:grid-cols-4">
    {
      STATS.map((s) => (
        <div class="text-ink text-center">
          <p class="display text-5xl md:text-6xl">{s.value}</p>
          <p class="mono mt-2 text-xs font-bold tracking-widest uppercase">
            {s.label}
          </p>
        </div>
      ))
    }
  </div>
</HalftoneSection>
