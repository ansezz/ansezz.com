---
import NeoCard from "@/components/neobrutalist/NeoCard.astro";
import NeoButton from "@/components/neobrutalist/NeoButton.astro";
import { Icon } from "astro-icon/components";
import { X_HANDLE } from "@/consts";
---

<section class="bg-bg border-ink border-t-[3px] py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-5">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p
          class="mono text-[10px] font-bold tracking-[0.2em] uppercase opacity-60"
        >
          ▸ Social
        </p>
        <h2 class="display mt-2 text-3xl md:text-4xl">Find me elsewhere.</h2>
        <p class="text-ink-soft mt-3 max-w-xl text-base">
          Production logs, shipping notes, contrarian takes — Laravel, Shopify,
          AI. Plus RSS and JSON feeds if you'd rather subscribe.
        </p>
      </div>
      <NeoButton href="/feed/" variant="primary" size="sm">
        All the links →
      </NeoButton>
    </div>

    <NeoCard
      tone="paper"
      href={`https://x.com/${X_HANDLE}`}
      hover
      class="block p-6 md:p-8"
    >
      <div class="mb-4 flex items-center justify-between">
        <div
          class="border-ink bg-ink text-bg inline-flex h-10 w-10 items-center justify-center rounded-[4px] border-[2.5px]"
        >
          <Icon name="lucide:twitter" class="h-5 w-5" />
        </div>
        <span
          class="border-ink bg-green text-on-accent shadow-neo-xs mono inline-flex items-center gap-1.5 rounded-full border-[2.5px] px-2.5 py-1 text-[10px] font-bold tracking-widest uppercase"
        >
          Follow
        </span>
      </div>
      <p
        class="mono text-[10px] font-bold tracking-widest uppercase opacity-60"
      >
        ▸ X · @{X_HANDLE}
      </p>
      <p class="display mt-1 text-2xl leading-tight md:text-3xl">
        Engineering threads.
      </p>
      <p class="mt-3 max-w-2xl text-sm leading-snug opacity-70 md:text-base">
        Shipping logs and hot takes, posted as they happen.
      </p>
      <p class="mono mt-5 text-[10px] font-bold tracking-widest uppercase">
        Open profile →
      </p>
    </NeoCard>
  </div>
</section>
