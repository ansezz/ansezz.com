---
import BurstBadge from "@/components/neobrutalist/BurstBadge.astro";
import { Icon } from "astro-icon/components";
import {
  TESTIMONIALS,
  OTHER_SHOPIFY_STOREFRONTS,
  OTHER_SHOPIFY_APPS,
  OTHER_PLATFORMS,
} from "@/consts";
import NeoCard from "@/components/neobrutalist/NeoCard.astro";
import { externalLinkAttrs } from "@/lib/links";

// Real social proof from shipped, live projects — no fabricated quotes.
// (If real testimonials are added to TESTIMONIALS later, they render above.)
const toneBg: Record<string, string> = {
  yellow: "bg-yellow text-on-accent",
  pink: "bg-pink text-on-accent",
  cyan: "bg-cyan text-on-accent",
  green: "bg-green text-on-accent",
  red: "bg-red text-on-accent",
  blue: "bg-blue text-on-deep",
  purple: "bg-purple text-on-deep",
  ink: "bg-ink text-bg",
};

// A curated, recognizable slice across storefronts, apps, and platforms.
const brands = [
  ...OTHER_SHOPIFY_STOREFRONTS.slice(0, 6),
  ...OTHER_SHOPIFY_APPS.slice(0, 1),
  ...OTHER_PLATFORMS.slice(0, 3),
];
---

<section class="mx-auto max-w-6xl px-5 py-16 md:py-20">
  <div class="mb-8">
    <BurstBadge tone="cyan" size="sm" class="mb-4">03</BurstBadge>
    <h2 class="display text-[clamp(1.75rem,4vw,3rem)] leading-[0.95]">
      Shipped for.
    </h2>
    <p
      class="mono mt-3 text-[11px] font-bold tracking-widest uppercase opacity-60"
    >
      ▸ A slice of live brands & platforms I've built and shipped
    </p>
  </div>

  {
    TESTIMONIALS.length > 0 && (
      <ul class="mb-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {TESTIMONIALS.map((t, i) => (
          <li class="min-w-0">
            <NeoCard
              tone={t.tone}
              shadow="md"
              tilt={i % 2 === 0 ? -0.4 : 0.4}
              class="flex h-full flex-col gap-4"
            >
              <p class="text-base leading-snug font-medium md:text-lg">
                <span class="display mr-1 align-top text-2xl">“</span>
                {t.quote}
              </p>
              <div class="border-ink mt-auto border-t-[2.5px] pt-2">
                <p class="text-sm font-bold">{t.name}</p>
                <p class="mono text-[10px] font-bold tracking-widest uppercase opacity-70">
                  {t.role}
                </p>
              </div>
            </NeoCard>
          </li>
        ))}
      </ul>
    )
  }

  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      brands.map((b) => (
        <li class="min-w-0">
          <a
            href={b.url}
            {...externalLinkAttrs(b.url)}
            class="group border-ink bg-paper shadow-neo-xs hover:shadow-neo-sm hover:bg-yellow flex items-center gap-3 rounded-[4px] border-[2.5px] p-3 transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
          >
            <span
              class:list={[
                "border-ink inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-[2px] text-sm font-black",
                toneBg[b.tone],
              ]}
            >
              {b.name.slice(0, 1)}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-bold">
                {b.name}
                <span class="ml-1 inline-block align-middle opacity-60">↗</span>
              </span>
              <span class="mono block truncate text-[10px] tracking-widest uppercase opacity-70">
                {b.note}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <a
      href="/work/"
      class="border-ink bg-ink text-bg shadow-neo-xs hover:shadow-neo-sm inline-flex items-center gap-2 border-[2.5px] px-4 py-2 text-sm font-bold tracking-wide uppercase transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
    >
      <Icon name="lucide:arrow-right" class="h-4 w-4" />
      See all work
    </a>
    <p class="mono text-[11px] font-bold tracking-widest uppercase opacity-60">
      ▸ 60+ production builds total
    </p>
  </div>
</section>
