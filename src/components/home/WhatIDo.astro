---
import NeoCard from "@/components/neobrutalist/NeoCard.astro";
import BurstBadge from "@/components/neobrutalist/BurstBadge.astro";
import TagPill from "@/components/neobrutalist/TagPill.astro";
import { Icon } from "astro-icon/components";
import { WHAT_I_DO } from "@/consts";

const cardStacks: Record<string, string[]> = {
  "Laravel SaaS that scales": [
    "Laravel",
    "PostgreSQL",
    "Octane",
    "Filament",
    "Horizon",
  ],
  "Shopify Plus apps": [
    "Remix",
    "GraphQL Admin",
    "App Bridge",
    "Polaris",
    "Functions",
  ],
  "AI engineering": ["Claude API", "MCP", "RAG", "pgvector", "Evals"],
  "Architecture & leadership": [
    "Clean Arch",
    "DDD",
    "TDD",
    "Audits",
    "Mentorship",
  ],
};

const cardTagTones: Record<string, "yellow" | "paper" | "ink"> = {
  red: "yellow",
  green: "paper",
  purple: "yellow",
  cyan: "paper",
};
---

<section class="relative mx-auto max-w-6xl px-5 py-16 md:py-24">
  <div class="mb-10 max-w-2xl">
    <BurstBadge tone="cyan" size="sm" class="mb-5">01</BurstBadge>
    <h2 class="display text-[clamp(2rem,4.5vw,3.25rem)] leading-[0.95]">
      Four lanes. Let's work together on
      <span class="bg-yellow -mx-1 inline-block px-2">any of them</span>.
    </h2>
    <p class="text-ink-soft mt-4 text-base leading-snug md:text-lg">
      Scoped, time-boxed, senior. Pick one — or stack two.
    </p>
  </div>

  <ul class="grid gap-6 md:grid-cols-2">
    {
      WHAT_I_DO.map((item, i) => {
        const stacks = cardStacks[item.title] ?? [];
        const tagTone = cardTagTones[item.tone] ?? "paper";
        return (
          <li>
            <NeoCard
              tone={item.tone}
              hover
              href={item.href}
              class="group flex h-full flex-col gap-4"
              tilt={i % 2 === 0 ? -0.4 : 0.4}
            >
              <header class="flex items-start gap-3">
                <span
                  class="border-ink bg-paper text-ink shadow-neo-xs inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-[6px] border-[2.5px]"
                  aria-hidden="true"
                >
                  <Icon name={item.icon} class="h-5 w-5" />
                </span>
                <div class="min-w-0 flex-1">
                  <p class="mono text-[10px] font-bold tracking-widest uppercase">
                    ▸ Lane {String(i + 1).padStart(2, "0")}
                  </p>
                  <h3 class="heading mt-0.5 text-xl leading-tight uppercase md:text-2xl">
                    {item.title}
                  </h3>
                </div>
                <span
                  class="border-ink bg-ink text-bg inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-[2px] text-xs font-black"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
              </header>

              <p class="text-sm leading-snug opacity-90 md:text-base">
                {item.body}
              </p>

              {stacks.length > 0 && (
                <ul class="mt-1 flex flex-wrap gap-1.5">
                  {stacks.map((s) => (
                    <li>
                      <TagPill tone={tagTone} size="sm">
                        {s}
                      </TagPill>
                    </li>
                  ))}
                </ul>
              )}

              <p class="border-ink/20 group-hover:border-ink/40 mt-auto flex items-center gap-2 border-t-[2px] pt-3 text-sm font-bold transition-colors">
                <span>{item.cta}</span>
                <span
                  aria-hidden="true"
                  class="transition-transform group-hover:translate-x-1"
                >
                  →
                </span>
              </p>
            </NeoCard>
          </li>
        );
      })
    }
  </ul>
</section>
