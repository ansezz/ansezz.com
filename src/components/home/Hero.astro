---
import StickyNote from "@/components/neobrutalist/StickyNote.astro";
import TagPill from "@/components/neobrutalist/TagPill.astro";
import RobotMascot from "@/components/neobrutalist/RobotMascot.astro";
import NeoButton from "@/components/neobrutalist/NeoButton.astro";
import PageNumber from "@/components/neobrutalist/PageNumber.astro";
import AvailabilityBadge from "@/components/neobrutalist/AvailabilityBadge.astro";
import { Icon } from "astro-icon/components";
import { OWNER, SITE } from "@/consts";

const heroTags = [
  "Laravel",
  "Anthropic Claude",
  "Model Context Protocol",
  "Shopify Plus",
  "pgvector",
];
const tagTones = ["red", "purple", "cyan", "green", "blue"] as const;

// Deliberately NOT the headline numbers — those live in the <Stats /> band
// right below. These are the practical "how do we work together" facts.
const cardFacts = [
  { v: SITE.TZ, l: "Time zone" },
  { v: String(OWNER.REMOTE_SINCE), l: "Remote since" },
  { v: "≤24h", l: "Reply" },
];
---

<section
  class="relative mx-auto max-w-6xl overflow-x-clip px-5 pt-10 pb-14 md:pt-14 md:pb-20 lg:pt-16 lg:pb-24"
>
  <PageNumber
    n="01"
    position="tr"
    class="!text-ink/[0.05] hidden !text-[12rem] md:block"
  />

  <div
    class="grid gap-10 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:items-center lg:gap-14"
  >
    <div class="min-w-0">
      <p
        class="mono text-accent-text mb-6 inline-flex items-center gap-2 text-xs font-bold tracking-widest uppercase sm:text-sm"
      >
        <span class="bg-pink-deep inline-block h-[3px] w-5 sm:w-6"></span>
        Senior Lead Engineer · {OWNER.YEARS_EXPERIENCE}+ yrs · Remote since {
          OWNER.REMOTE_SINCE
        }
      </p>

      <h1
        class="display text-[clamp(2.5rem,6vw,4.75rem)] leading-[0.95] tracking-tight"
      >
        Backends that survive prod.
        <span class="mt-2 block">AI features with</span>
        <span class="mt-3 block">
          <span
            class="bg-pink text-on-accent border-ink shadow-neo-md inline-block border-[3px] px-3 py-1 sm:whitespace-nowrap"
          >
            evals, not vibes.
          </span>
        </span>
      </h1>

      <p
        class="text-ink-soft mt-7 max-w-2xl text-base leading-snug font-medium sm:text-lg md:text-xl"
      >
        Senior Lead Backend Engineer, Software Architect, and AI Engineer.
        Production Laravel SaaS, Shopify Plus apps, and AI features — Claude,
        MCP, RAG — for founders, agencies, and product teams.
      </p>

      <div class="mt-7">
        <AvailabilityBadge label={OWNER.STATUS} />
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <NeoButton href="/contact/" variant="danger" size="lg">
          <Icon name="lucide:mail" class="h-4 w-4" />
          Let's work together
        </NeoButton>
        <NeoButton href={SITE.BOOKING_URL} variant="primary" size="lg">
          <Icon name="lucide:calendar" class="h-4 w-4" />
          Book a 15-min call
        </NeoButton>
        <NeoButton href="/work/" variant="secondary" size="lg">
          See work →
        </NeoButton>
      </div>

      <div class="mt-9">
        <p
          class="mono mb-2 text-[11px] font-bold tracking-widest uppercase opacity-60"
        >
          ▸ Daily stack
        </p>
        <ul class="flex flex-wrap gap-2">
          {
            heroTags.map((t, i) => (
              <li>
                <TagPill tone={tagTones[i % tagTones.length]} size="sm">
                  {t}
                </TagPill>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <aside
      class="relative isolate mx-auto w-full max-w-[420px] lg:mx-0 lg:max-w-none"
      data-mascot="hero"
    >
      <div
        class="border-ink bg-cyan shadow-neo-xl relative overflow-hidden rounded-[6px] border-[3px]"
      >
        <span
          class="halftone pointer-events-none absolute inset-0 opacity-25"
          aria-hidden="true"></span>

        <header
          class="border-ink bg-ink text-bg relative z-10 flex items-center justify-between gap-2 border-b-[3px] px-3 py-2"
        >
          <span class="mono text-[10px] font-bold tracking-widest uppercase">
            ▸ trading-card.dev
          </span>
          <span
            class="mono inline-flex items-center gap-1.5 text-[10px] font-bold tracking-widest uppercase"
          >
            <span
              class="bg-green neo-pulse-dot inline-block h-1.5 w-1.5 rounded-full"
            ></span>
            LIVE
          </span>
        </header>

        <div
          class="relative flex flex-col items-center gap-3 px-5 pt-5 pb-4 text-center"
        >
          <RobotMascot
            tone="yellow"
            size={130}
            class="md:!h-[150px] md:!w-[150px]"
          />
          <div>
            <p class="display text-2xl leading-[1] tracking-tight md:text-3xl">
              {OWNER.NAME}
            </p>
            <p
              class="mono mt-1 text-[10px] font-bold tracking-widest uppercase opacity-80"
            >
              Backend · Architect · AI
            </p>
          </div>
        </div>

        <ul class="border-ink relative z-10 grid grid-cols-3 border-t-[3px]">
          {
            cardFacts.map((s, i) => (
              <li
                class:list={[
                  "bg-paper px-2 py-3 text-center",
                  i < 2 && "border-ink border-r-[3px]",
                ]}
              >
                <p class="display text-xl leading-none md:text-2xl">{s.v}</p>
                <p class="mono mt-1 text-[10px] font-bold tracking-widest uppercase opacity-70">
                  {s.l}
                </p>
              </li>
            ))
          }
        </ul>

        <footer
          class="border-ink bg-yellow text-on-accent relative z-10 border-t-[3px] px-4 py-3"
        >
          <p class="mono mb-1 text-[10px] font-bold tracking-widest uppercase">
            ▸ Now shipping
          </p>
          <p class="text-xs leading-snug font-bold">
            {OWNER.CURRENTLY}
          </p>
        </footer>
      </div>

      <div
        class="absolute -top-4 -right-4 z-20 rotate-[7deg] md:-top-5 md:-right-6"
      >
        <StickyNote tone="pink" tilt={0} class="max-w-[180px]">
          <p class="mono mb-1 text-[10px] font-bold tracking-widest uppercase">
            ▸ First step
          </p>
          <p class="text-xs leading-snug font-bold">
            Free 15-min intro call. Honest yes or no.
          </p>
        </StickyNote>
      </div>
    </aside>
  </div>
</section>
