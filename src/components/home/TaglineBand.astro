---
import HalftoneSection from "@/components/neobrutalist/HalftoneSection.astro";
import PanelDivider from "@/components/neobrutalist/PanelDivider.astro";
import { YEARS_REMOTE } from "@/consts";
---

<HalftoneSection tone="pink" bordered class="py-16 md:py-24">
  <div class="text-ink mx-auto max-w-5xl px-5 text-center">
    <p class="mono mb-4 text-xs font-bold tracking-widest uppercase opacity-70">
      ▸ Operating principle
    </p>

    <figure class="relative inline-block max-w-3xl">
      <div
        class="bg-paper border-ink shadow-neo-lg relative inline-block rounded-[8px] border-[3px] px-6 py-8 md:px-12 md:py-14"
      >
        <blockquote
          class="display text-[clamp(1.75rem,4.5vw,3.5rem)] leading-[1] tracking-tight"
        >
          Ship the thing.
          <span class="block">
            Then make it
            <span class="bg-yellow text-on-accent -mx-1 inline-block px-2"
              >unfair</span
            >.
          </span>
        </blockquote>

        <svg
          class="absolute -bottom-6 left-12 h-9 w-12"
          viewBox="0 0 48 36"
          aria-hidden="true"
        >
          <path d="M0 0 L48 0 L12 36 Z" fill="var(--color-paper)"></path>
          <path
            d="M0 0 L48 0 L12 36 Z"
            fill="none"
            stroke="var(--color-ink)"
            stroke-width="3"
            stroke-linejoin="round"></path>
        </svg>
      </div>
    </figure>

    <p class="mx-auto mt-12 max-w-2xl text-base opacity-90 md:text-lg">
      Production-ready, observable, opinionated. Backed by tests, types, and
      {YEARS_REMOTE} years of remote-only scar tissue.
    </p>

    <div class="mt-8">
      <PanelDivider tone="yellow" shape="bolt" class="!my-0" />
    </div>
  </div>
</HalftoneSection>
