---
import type { CollectionEntry } from "astro:content";
import TagPill from "@/components/neobrutalist/TagPill.astro";
import NeoButton from "@/components/neobrutalist/NeoButton.astro";
import { Icon } from "astro-icon/components";

type Tone = "paper" | "yellow" | "pink" | "cyan" | "green" | "red" | "purple";

interface Props {
  entry: CollectionEntry<"work">;
  tone?: Tone;
}

const { entry, tone = "paper" } = Astro.props;

// Featured entries have a full case-study detail page.
const caseStudyHref = entry.data.featured ? `/work/${entry.id}/` : undefined;

const toneClass: Record<Tone, string> = {
  paper: "bg-paper text-ink",
  yellow: "bg-yellow text-ink",
  pink: "bg-pink text-ink",
  cyan: "bg-cyan text-ink",
  green: "bg-green text-ink",
  red: "bg-red text-ink",
  purple: "bg-purple text-paper",
};

const tagTone = tone === "paper" ? "yellow" : "paper";
---

<article
  data-neo-hover
  class:list={[
    "group border-ink shadow-neo-md hover:shadow-neo-lg relative flex h-full flex-col gap-4 rounded-[4px] border-[3px] p-6 transition-all duration-150 hover:-translate-x-1 hover:-translate-y-1 md:p-7",
    toneClass[tone],
  ]}
>
  <header class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p
        class="mono mb-2 text-[10px] font-bold tracking-widest uppercase opacity-70"
      >
        ▸ {entry.data.category}
      </p>
      <h3 class="heading text-2xl leading-tight md:text-3xl">
        {
          caseStudyHref ? (
            <a
              href={caseStudyHref}
              class="decoration-[3px] underline-offset-4 after:absolute after:inset-0 hover:underline"
            >
              {entry.data.title}
            </a>
          ) : (
            entry.data.title
          )
        }
      </h3>
    </div>
    {
      entry.data.featured && (
        <span
          class={`border-ink shadow-neo-xs inline-flex items-center gap-1 rounded-full border-[2px] px-2.5 py-0.5 text-[10px] font-bold uppercase ${tone === "yellow" ? "bg-pink text-ink" : "bg-yellow text-ink"}`}
        >
          ★ Featured
        </span>
      )
    }
  </header>

  <p class="text-sm leading-snug opacity-90 md:text-base">
    {entry.data.description}
  </p>

  {
    entry.data.outcome && (
      <p class="mono bg-ink text-bg inline-flex w-fit max-w-full items-start gap-2 px-3 py-2 text-xs font-bold tracking-wider break-words uppercase">
        <Icon name="lucide:trending-up" class="mt-0.5 h-4 w-4 shrink-0" />
        <span>{entry.data.outcome}</span>
      </p>
    )
  }

  {
    entry.data.stack.length > 0 && (
      <ul class="flex flex-wrap gap-1.5">
        {entry.data.stack.map((s) => (
          <li>
            <TagPill tone={tagTone} size="sm">
              {s}
            </TagPill>
          </li>
        ))}
      </ul>
    )
  }

  {
    (caseStudyHref || entry.data.liveUrl || entry.data.githubUrl) && (
      <div class="relative z-10 mt-auto flex flex-wrap gap-2.5 pt-2">
        {caseStudyHref && (
          <NeoButton href={caseStudyHref} variant="ink" size="sm">
            Case study
            <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
          </NeoButton>
        )}
        {entry.data.liveUrl && (
          <NeoButton
            href={entry.data.liveUrl}
            variant={caseStudyHref ? "secondary" : "ink"}
            size="sm"
          >
            <Icon name="lucide:external-link" class="h-3.5 w-3.5" />
            Live
          </NeoButton>
        )}
        {entry.data.githubUrl && (
          <NeoButton href={entry.data.githubUrl} variant="secondary" size="sm">
            <Icon name="lucide:github" class="h-3.5 w-3.5" />
            Source
          </NeoButton>
        )}
      </div>
    )
  }
</article>
