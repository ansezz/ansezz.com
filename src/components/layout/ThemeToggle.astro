---
import { Icon } from "astro-icon/components";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
  class:list={[
    "border-ink bg-paper text-ink shadow-neo-xs hover:bg-yellow hover:shadow-neo-sm inline-flex h-10 w-10 items-center justify-center border-[2px] transition-all hover:-translate-x-0.5 hover:-translate-y-0.5",
    className,
  ]}
>
  <Icon name="lucide:sun" class="theme-icon-sun hidden h-5 w-5" />
  <Icon name="lucide:moon" class="theme-icon-moon hidden h-5 w-5" />
</button>

<script>
  import "@/scripts/theme-toggle";
</script>
