---
import Nav from "./Nav.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "@/consts";
import { externalLinkAttrs } from "@/lib/links";
---

<header class="border-ink bg-bg sticky top-0 z-40 border-b-[3px]">
  <div
    class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-3"
  >
    <a
      href="/"
      class="display hover:bg-yellow -mx-1.5 px-1.5 py-1 text-2xl tracking-tight transition-colors"
    >
      {SITE.SHORT_TITLE}<span class="text-pink">.</span>
    </a>
    <div class="hidden items-center gap-3 lg:flex">
      <Nav />
      <button
        type="button"
        data-cmdk-open
        aria-label="Open command menu (Cmd+K)"
        title="Search & jump — ⌘K"
        class="border-ink bg-paper text-ink shadow-neo-xs hover:bg-yellow hover:shadow-neo-sm inline-flex h-10 items-center gap-2 border-[2px] px-3 transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
      >
        <Icon name="lucide:search" class="h-4 w-4" />
        <kbd class="mono text-[10px] font-bold">⌘K</kbd>
      </button>
      <ThemeToggle />
      <a
        href="/contact/"
        class="border-ink bg-pink-deep text-on-deep shadow-neo-xs hover:shadow-neo-sm inline-flex items-center gap-1.5 border-[2.5px] px-3.5 py-1.5 text-xs font-bold tracking-wide uppercase transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
        aria-label="Work with me — get in touch"
      >
        <Icon name="lucide:mail" class="h-3.5 w-3.5" />
        Let's talk
      </a>
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <ThemeToggle />
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle menu"
        class="border-ink bg-paper shadow-neo-sm hover:bg-yellow inline-flex h-10 w-10 items-center justify-center border-[2px] transition-all"
      >
        <Icon name="lucide:menu" class="menu-icon-open h-5 w-5" />
        <Icon name="lucide:x" class="menu-icon-close hidden h-5 w-5" />
      </button>
    </div>

    <div
      id="mobile-menu"
      hidden
      class="border-ink bg-bg border-t-[3px] lg:hidden"
    >
      <div class="mx-auto max-w-5xl space-y-3 px-5 py-4">
        <Nav vertical />
        <a
          href="/contact/"
          class="border-ink bg-pink-deep text-on-deep shadow-neo-sm hover:shadow-neo-md flex items-center justify-center gap-2 border-[3px] px-4 py-3 text-sm font-bold uppercase transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
          aria-label="Work with me — get in touch"
        >
          <Icon name="lucide:mail" class="h-4 w-4" />
          Let's work together
        </a>
        <a
          href={SITE.RESUME_URL}
          {...externalLinkAttrs(SITE.RESUME_URL)}
          class="border-ink bg-paper shadow-neo-xs hover:shadow-neo-sm flex items-center justify-center gap-2 border-[2.5px] px-4 py-2.5 text-xs font-bold uppercase transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
          aria-label="Download resume PDF"
        >
          <Icon name="lucide:download" class="h-4 w-4" />
          Resume (PDF)
        </a>
      </div>
    </div>

    <noscript>
      <style>
        #mobile-menu-toggle {
          display: none !important;
        }
      </style>
      <div class="border-ink bg-bg border-t-[3px] lg:hidden">
        <div class="mx-auto max-w-5xl space-y-3 px-5 py-4">
          <Nav vertical />
          <a
            href="/contact/"
            class="border-ink bg-pink-deep text-on-deep shadow-neo-sm flex items-center justify-center gap-2 border-[3px] px-4 py-3 text-sm font-bold uppercase"
          >
            <Icon name="lucide:mail" class="h-4 w-4" />
            Let's work together
          </a>
          <a
            href={SITE.RESUME_URL}
            class="border-ink bg-paper shadow-neo-xs flex items-center justify-center gap-2 border-[2.5px] px-4 py-2.5 text-xs font-bold uppercase"
          >
            <Icon name="lucide:download" class="h-4 w-4" />
            Resume (PDF)
          </a>
        </div>
      </div>
    </noscript>
  </div>

  <script>
    import "@/scripts/mobile-menu";
  </script>
</header>
