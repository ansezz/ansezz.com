---
import { Icon } from "astro-icon/components";
import { SITE, SOCIALS, OWNER, NAV, FOOTER_MORE } from "@/consts";
import { externalLinkAttrs } from "@/lib/links";

const year = new Date().getFullYear();

const socialIcons = SOCIALS.filter((s) =>
  ["GitHub", "LinkedIn", "X", "Threads", "Instagram", "Facebook"].includes(
    s.NAME,
  ),
);
const directLinks = SOCIALS.filter((s) =>
  ["Email", "Phone", "Book a call", "Resume (PDF)"].includes(s.NAME),
);

// Feed lives in the "Site" column above; /styleguide/ is Disallow-ed in
// robots.txt, so it doesn't belong in a sitewide footer either.
const bottomLinks = [
  { label: "Privacy", href: "/privacy/" },
  { label: "RSS", href: "/rss.xml" },
  { label: "JSON Feed", href: "/feed.json" },
];
---

<footer
  class="border-ink bg-ink text-bg relative mt-24 overflow-hidden border-t-[3px]"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.08]"
    style="background-image: radial-gradient(circle, var(--color-paper) 1px, transparent 1px); background-size: 14px 14px;"
  >
  </div>

  <div
    class="relative mx-auto grid max-w-6xl gap-10 px-5 pt-12 pb-8 sm:grid-cols-2 sm:gap-12 sm:px-6 sm:pt-14 sm:pb-10 lg:grid-cols-4"
  >
    <div class="space-y-5 sm:col-span-2 lg:col-span-1">
      <a href="/" class="group inline-flex items-baseline">
        <span
          class="display group-hover:text-yellow text-3xl tracking-tight transition-colors sm:text-4xl"
        >
          {SITE.SHORT_TITLE}
        </span>
        <span class="text-pink display text-3xl sm:text-4xl">.</span>
      </a>
      <p class="max-w-sm text-sm leading-relaxed opacity-80">
        {OWNER.ROLES.join(" · ")}. {OWNER.YEARS_EXPERIENCE}+ years shipping
        Laravel SaaS, Shopify Plus apps, and production AI. Remote-first since
        {OWNER.REMOTE_SINCE}.
      </p>

      <div
        class="border-bg bg-bg/5 inline-flex items-center gap-2 rounded-full border-[2.5px] px-3 py-2 backdrop-blur-sm"
      >
        <span class="relative inline-flex h-2 w-2">
          <span
            class="bg-green absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"
          ></span>
          <span class="bg-green relative inline-flex h-2 w-2 rounded-full"
          ></span>
        </span>
        <span class="mono text-[10px] font-bold tracking-widest uppercase">
          Open · Senior / Lead / Advisory
        </span>
      </div>
    </div>

    <div>
      <p
        class="mono mb-4 text-[10px] font-bold tracking-[0.2em] uppercase opacity-50"
      >
        ▸ Site
      </p>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-1">
        {
          NAV.map((n) => (
            <li>
              <a
                href={n.HREF}
                class="hover:text-yellow inline-block text-sm font-bold opacity-90 transition-colors hover:opacity-100"
              >
                {n.LABEL}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/feed/"
            class="hover:text-yellow inline-block text-sm font-bold opacity-90 transition-colors hover:opacity-100"
          >
            Feed
          </a>
        </li>
        {
          FOOTER_MORE.map((n) => (
            <li>
              <a
                href={n.HREF}
                class="hover:text-yellow inline-block text-sm font-bold opacity-90 transition-colors hover:opacity-100"
              >
                {n.LABEL}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p
        class="mono mb-4 text-[10px] font-bold tracking-[0.2em] uppercase opacity-50"
      >
        ▸ Connect
      </p>
      <ul class="mb-5 flex flex-wrap gap-2">
        {
          socialIcons.map((s) => (
            <li>
              <a
                href={s.HREF}
                {...externalLinkAttrs(s.HREF)}
                aria-label={s.NAME}
                title={s.NAME}
                class="border-bg/30 bg-bg/5 hover:bg-yellow hover:text-ink hover:border-bg inline-flex h-10 w-10 items-center justify-center rounded-[4px] border-[2.5px] transition-all hover:-translate-y-0.5"
              >
                <Icon name={s.ICON} class="h-4 w-4" />
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="space-y-2">
        {
          directLinks.map((s) => (
            <li>
              <a
                href={s.HREF}
                {...externalLinkAttrs(s.HREF)}
                class="hover:text-yellow inline-flex items-center gap-2 text-sm font-bold opacity-90 transition-colors hover:opacity-100"
              >
                <Icon name={s.ICON} class="h-3.5 w-3.5 shrink-0" />
                <span class="truncate">{s.NAME}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="space-y-5">
      <div>
        <p
          class="mono mb-4 text-[10px] font-bold tracking-[0.2em] uppercase opacity-50"
        >
          ▸ Based in
        </p>
        <p class="text-base font-bold">{SITE.LOCATION}</p>
        <p class="mt-1 text-sm opacity-70">{SITE.TZ} · Remote-first</p>
      </div>

      <div class="border-bg/30 bg-bg/5 rounded-[4px] border-[2.5px] p-4">
        <p
          class="mono mb-2 text-[10px] font-bold tracking-widest uppercase opacity-60"
        >
          ▸ Overlap windows
        </p>
        <p class="text-xs leading-relaxed opacity-90">
          EU <span class="font-bold">09–13 CET</span><br />
          US East <span class="font-bold">14–18 CET</span><br />
          Async-first · Reply ≤24h
        </p>
      </div>
    </div>
  </div>

  <div class="border-bg/15 relative border-t">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-4 text-xs sm:flex-row sm:items-center sm:justify-between sm:px-6 sm:py-5"
    >
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 opacity-70">
        <span>© {year} {OWNER.NAME}</span>
        <span class="mono hidden opacity-60 sm:inline">·</span>
        <span class="mono opacity-60">Built with Astro + Tailwind ✦</span>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        {
          bottomLinks.map((l) => (
            <a
              href={l.href}
              class="border-bg/30 bg-bg/5 mono hover:bg-yellow hover:text-ink hover:border-bg inline-flex items-center rounded-full border-[2px] px-2.5 py-1 text-[10px] font-bold tracking-widest uppercase transition-all"
            >
              {l.label}
            </a>
          ))
        }
        <a
          href="#top"
          aria-label="Back to top"
          class="border-bg/30 bg-bg/5 hover:bg-pink hover:text-paper hover:border-bg inline-flex h-7 w-7 items-center justify-center rounded-full border-[2px] transition-all"
        >
          <Icon name="lucide:arrow-up" class="h-3 w-3" />
        </a>
      </div>
    </div>
  </div>
</footer>
