---
import { getCollection } from "astro:content";
import Page from "@/layouts/Page.astro";
import NeoCard from "@/components/neobrutalist/NeoCard.astro";
import HalftoneSection from "@/components/neobrutalist/HalftoneSection.astro";
import PostMeta from "@/components/blog/PostMeta.astro";
import { Icon } from "astro-icon/components";
import { getReadingTime } from "@/lib/reading";
import { externalLinkAttrs } from "@/lib/links";
import { SITE, SOCIALS, BLOG_CATEGORIES, CATEGORY_LABEL } from "@/consts";
import { breadcrumbList } from "@/lib/seo";

const feedBreadcrumbLd = breadcrumbList([
  { name: "Home", url: SITE.URL },
  { name: "Feed", url: "/feed/" },
]);

// Social profiles worth surfacing here (icon links, no embedded widgets —
// third-party timeline embeds track visitors and break for logged-out users).
const PROFILE_NAMES = [
  "GitHub",
  "LinkedIn",
  "X",
  "Threads",
  "Instagram",
  "Facebook",
];
const profiles = PROFILE_NAMES.map((n) =>
  SOCIALS.find((s) => s.NAME === n),
).filter((s): s is (typeof SOCIALS)[number] => Boolean(s));

const subscribe = [
  {
    label: "RSS",
    href: "/rss.xml",
    icon: "lucide:rss",
    tone: "pink" as const,
    note: "Every post, full text. Works in any reader.",
  },
  {
    label: "JSON Feed",
    href: "/feed.json",
    icon: "lucide:braces",
    tone: "cyan" as const,
    note: "Same posts, JSON Feed 1.1 for tooling and agents.",
  },
  {
    label: "llms.txt",
    href: "/llms.txt",
    icon: "lucide:bot",
    tone: "purple" as const,
    note: "A map of this site for LLMs and AI crawlers.",
  },
];

const latest = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 5);
---

<Page
  title="Feed"
  description={`Follow ${SITE.SHORT_TITLE} — RSS, JSON Feed, per-topic feeds, and every social profile in one place. No tracking widgets.`}
  eyebrow="Follow"
  heading="Every way to follow along."
  intro="Subscribe by feed, or find me wherever you already read. No embedded timelines, no third-party trackers — just links."
  structuredData={feedBreadcrumbLd}
>
  <div class="mx-auto max-w-4xl space-y-14 px-5 pb-16">
    <section>
      <h2 class="display mb-2 text-2xl leading-tight md:text-3xl">
        Subscribe.
      </h2>
      <p
        class="mono mb-5 text-[11px] font-bold tracking-widest uppercase opacity-60"
      >
        ▸ Push, not pull — new posts come to you
      </p>
      <ul class="grid gap-4 sm:grid-cols-3">
        {
          subscribe.map((s) => (
            <li>
              <a href={s.href} class="block h-full" data-neo-hover>
                <NeoCard
                  tone={s.tone}
                  shadow="sm"
                  class="hover:shadow-neo-md flex h-full flex-col gap-2 transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
                >
                  <span
                    class="border-ink bg-paper text-ink shadow-neo-xs inline-flex h-10 w-10 items-center justify-center rounded-[6px] border-[2.5px]"
                    aria-hidden="true"
                  >
                    <Icon name={s.icon} class="h-5 w-5" />
                  </span>
                  <p class="heading text-base leading-tight uppercase">
                    {s.label}
                  </p>
                  <p class="text-sm leading-snug opacity-90">{s.note}</p>
                </NeoCard>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class="display mb-2 text-2xl leading-tight md:text-3xl">
        Only the topics you want.
      </h2>
      <p
        class="mono mb-5 text-[11px] font-bold tracking-widest uppercase opacity-60"
      >
        ▸ One RSS feed per category
      </p>
      <ul class="flex flex-wrap gap-2">
        {
          BLOG_CATEGORIES.map((c) => (
            <li>
              <a
                href={`/rss/${c}.xml`}
                class="border-ink bg-paper shadow-neo-xs hover:bg-yellow hover:shadow-neo-sm inline-flex items-center gap-2 rounded-full border-[2.5px] px-3.5 py-1.5 text-xs font-bold tracking-wide uppercase transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
              >
                <Icon name="lucide:rss" class="h-3.5 w-3.5" />
                {CATEGORY_LABEL[c]}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class="display mb-2 text-2xl leading-tight md:text-3xl">
        Elsewhere.
      </h2>
      <p
        class="mono mb-5 text-[11px] font-bold tracking-widest uppercase opacity-60"
      >
        ▸ Shipping logs, threads, and the occasional hot take
      </p>
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          profiles.map((s) => (
            <li>
              <a
                href={s.HREF}
                {...externalLinkAttrs(s.HREF)}
                class="group border-ink bg-paper shadow-neo-xs hover:bg-yellow hover:shadow-neo-sm flex items-center gap-3 rounded-[4px] border-[2.5px] p-3 transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
              >
                <span
                  class="border-ink bg-ink text-paper inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-[2px]"
                  aria-hidden="true"
                >
                  <Icon name={s.ICON} class="h-4 w-4" />
                </span>
                <span class="min-w-0 flex-1 text-sm font-bold">
                  {s.NAME}
                  <span class="ml-1 inline-block align-middle opacity-60">
                    ↗
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      latest.length > 0 && (
        <section>
          <h2 class="display mb-2 text-2xl leading-tight md:text-3xl">
            Latest posts.
          </h2>
          <p class="mono mb-5 text-[11px] font-bold tracking-widest uppercase opacity-60">
            ▸ The last {latest.length} out of the oven
          </p>
          <ol class="space-y-3">
            {latest.map((post, i) => (
              <li>
                <a href={`/blog/${post.id}/`} class="block" data-neo-hover>
                  <NeoCard
                    tone="paper"
                    shadow="sm"
                    class="hover:shadow-neo-md flex items-start gap-4 transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
                  >
                    <span class="display shrink-0 text-2xl leading-none opacity-40">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <div class="min-w-0 flex-1">
                      <h3 class="heading text-base leading-tight uppercase md:text-lg">
                        {post.data.title}
                      </h3>
                      <div class="mt-2">
                        <PostMeta
                          date={post.data.publishDate}
                          updatedDate={post.data.updatedDate}
                          category={post.data.category}
                          readingTime={getReadingTime(post.body)}
                          linkCategory={false}
                        />
                      </div>
                    </div>
                  </NeoCard>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <HalftoneSection
      tone="bg"
      class="border-ink -mx-5 border-y-[3px] px-5 py-8"
    >
      <div class="mx-auto max-w-3xl text-center">
        <p
          class="mono mb-3 text-[10px] font-bold tracking-[0.2em] uppercase opacity-60"
        >
          ▸ Prefer the long form?
        </p>
        <p class="text-base leading-snug md:text-lg">
          Bite-sized takes on social. Full essays —{" "}
          <a
            href="/blog/"
            class="decoration-pink hover:bg-yellow underline decoration-[3px] underline-offset-4"
          >
            on the blog
          </a>
          , grouped into{" "}
          <a
            href="/blog/series/"
            class="decoration-pink hover:bg-yellow underline decoration-[3px] underline-offset-4"
          >
            reading series
          </a>.
        </p>
      </div>
    </HalftoneSection>
  </div>
</Page>
