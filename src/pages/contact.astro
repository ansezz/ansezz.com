---
import Page from "@/layouts/Page.astro";
import NeoCard from "@/components/neobrutalist/NeoCard.astro";
import AvailabilityBadge from "@/components/neobrutalist/AvailabilityBadge.astro";
import StickyNote from "@/components/neobrutalist/StickyNote.astro";
import ContactLeadForm from "@/components/contact/ContactLeadForm.astro";
import ContactRest from "@/components/contact/ContactRest.astro";
import { Icon } from "astro-icon/components";
import {
  CONTACT,
  CONTACT_FORM,
  SITE,
  OWNER,
  PACKAGE_LABEL,
  LANE_TO_PACKAGE,
} from "@/consts";
import { breadcrumbList } from "@/lib/seo";

const formEnabled = CONTACT_FORM.ACCESS_KEY !== "";

const rawPrefill = (
  Astro.url.searchParams.get("package") ??
  Astro.url.searchParams.get("lane") ??
  ""
)
  .toLowerCase()
  .trim();
const prefillId =
  rawPrefill in PACKAGE_LABEL
    ? (rawPrefill as keyof typeof PACKAGE_LABEL)
    : (LANE_TO_PACKAGE[rawPrefill] ?? null);
const prefillLabel = prefillId ? PACKAGE_LABEL[prefillId] : null;
---

<Page
  title={CONTACT.TITLE}
  description={CONTACT.DESCRIPTION}
  eyebrow="Work with me"
  heading="Let's build something."
  intro="Senior backend, software architect, AI engineer. Booked weekly, but I keep slots for serious projects. Two ways to start — email me, or book a 15-min intro."
  structuredData={breadcrumbList([
    { name: "Home", url: SITE.URL },
    { name: "Contact", url: "/contact/" },
  ])}
>
  <section class="mx-auto max-w-5xl space-y-6 px-5 pb-12">
    <div class="flex flex-wrap items-center gap-4">
      <AvailabilityBadge label={OWNER.STATUS} />
      <StickyNote tone="yellow" tilt={-2} class="max-w-[280px]">
        <p class="mono mb-1 text-[10px] font-bold tracking-widest uppercase">
          ▸ Response window
        </p>
        <p class="text-sm leading-snug font-bold">
          Email: ≤ 24h on weekdays. First call ≤ 5 business days.
        </p>
      </StickyNote>
    </div>

    {
      formEnabled && (
        <NeoCard tone="paper" shadow="lg" class="!p-6 md:!p-8">
          <p class="mono text-accent-text mb-1 text-[11px] font-bold tracking-widest uppercase">
            ▸ Option A · just type it here
          </p>
          <p class="display mb-5 text-2xl leading-tight md:text-3xl">
            Send a message
          </p>
          <ContactLeadForm prefillId={prefillId} prefillLabel={prefillLabel} />
        </NeoCard>
      )
    }

    <ul class="grid gap-5 md:grid-cols-2">
      <li>
        <NeoCard
          href={`mailto:${SITE.EMAIL}?subject=Project inquiry`}
          tone="yellow"
          hover
          shadow="lg"
          class="h-full"
        >
          <div class="flex items-start gap-4">
            <span
              class="border-ink bg-paper text-ink shadow-neo-xs inline-flex h-14 w-14 items-center justify-center rounded-[6px] border-[2.5px]"
              aria-hidden="true"
            >
              <Icon name="lucide:mail" class="h-6 w-6" />
            </span>
            <div class="min-w-0 flex-1">
              <p
                class="mono mb-1 text-[11px] font-bold tracking-widest uppercase opacity-70"
              >
                ▸ Option B · email app
              </p>
              <p class="display mb-2 text-2xl leading-tight md:text-3xl">
                Send an email
              </p>
              <p class="inline-flex items-center gap-1.5 font-bold">
                Open your mail app
                <Icon name="lucide:arrow-up-right" class="h-4 w-4" />
              </p>
              <p class="mt-2 text-sm opacity-80">
                2–3 sentences on scope. Reply within 24h on weekdays.
              </p>
            </div>
          </div>
        </NeoCard>
      </li>
      <li>
        <NeoCard
          href={SITE.BOOKING_URL}
          tone="ink"
          hover
          shadow="lg"
          class="text-bg h-full"
        >
          <div class="flex items-start gap-4">
            <span
              class="border-bg bg-yellow text-on-accent shadow-neo-xs inline-flex h-14 w-14 items-center justify-center rounded-[6px] border-[2.5px]"
              aria-hidden="true"
            >
              <Icon name="lucide:calendar" class="h-6 w-6" />
            </span>
            <div class="min-w-0 flex-1">
              <p
                class="mono mb-1 text-[11px] font-bold tracking-widest uppercase opacity-60"
              >
                ▸ Option C · skip the email
              </p>
              <p class="display mb-2 text-2xl leading-tight md:text-3xl">
                Book a 15-min call
              </p>
              <p class="font-bold">Google Calendar · pick a slot</p>
              <p class="mt-2 text-sm opacity-70">
                Free. Honest. No deck, no pitch.
              </p>
            </div>
          </div>
        </NeoCard>
      </li>
    </ul>
  </section>

  <ContactRest />
</Page>

{
  formEnabled && (
    <>
      <script
        is:inline
        type="application/json"
        id="contact-package-map"
        set:html={JSON.stringify(PACKAGE_LABEL)}
      />
      <script
        is:inline
        type="application/json"
        id="contact-lane-map"
        set:html={JSON.stringify(LANE_TO_PACKAGE)}
      />
      <script>import "@/scripts/contact-form";</script>
    </>
  )
}
