---
import Page from "@/layouts/Page.astro";
import RelatedLinks from "@/components/RelatedLinks.astro";
import NeoCard from "@/components/neobrutalist/NeoCard.astro";
import StickyNote from "@/components/neobrutalist/StickyNote.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "@/consts";
import { breadcrumbList, faqPage } from "@/lib/seo";

const PAGE_TITLE = "HTTP Headers Cheat Sheet";
const PAGE_DESCRIPTION =
  "HTTP headers cheat sheet: every request and response header that matters in production, with real example values. Free, filterable, runs in your browser.";

const breadcrumbLd = breadcrumbList([
  { name: "Home", url: SITE.URL },
  { name: "Tools", url: "/tools/" },
  { name: PAGE_TITLE, url: "/tools/http-headers/" },
]);

/** Which side of the exchange the field appears on. */
type Dir = "req" | "res" | "both";

/**
 * legacy   — still works, something better replaced it
 * de-facto — in no RFC, but everyone implements it
 * draft    — standards-track, not finished
 * dead     — do not ship this
 */
type Flag = "legacy" | "de-facto" | "draft" | "dead";

interface HeaderRow {
  name: string;
  dir: Dir;
  /** One line: what the field is for. */
  purpose: string;
  /** A value you would actually see on the wire. */
  example: string;
  /** Optional second line: the trap, the caveat, the reason it bites. */
  note?: string;
  flag?: Flag;
  /** Extra search terms for the filter box; never rendered. */
  keywords?: string;
}

const DIR_LABEL: Record<Dir, string> = {
  req: "Request",
  res: "Response",
  both: "Request + response",
};

const DIR_CLASS: Record<Dir, string> = {
  req: "bg-cyan",
  res: "bg-green",
  both: "bg-yellow",
};

const FLAG_LABEL: Record<Flag, string> = {
  legacy: "Legacy",
  "de-facto": "De facto",
  draft: "Draft",
  dead: "Dead",
};

const FLAG_CLASS: Record<Flag, string> = {
  legacy: "bg-yellow",
  "de-facto": "bg-pink",
  draft: "bg-cyan",
  dead: "bg-bg-alt",
};

const CACHING: HeaderRow[] = [
  {
    name: "Cache-Control",
    dir: "both",
    purpose:
      "The entire caching policy in one field: how long a response stays fresh, who is allowed to store it, and what has to happen once it goes stale.",
    example: "Cache-Control: public, max-age=60, s-maxage=86400",
    note: "The same word means different things on a request and on a response. Every directive is spelled out in the next table.",
    keywords: "caching ttl freshness cdn",
  },
  {
    name: "Age",
    dir: "res",
    purpose:
      "Seconds this response has already spent sitting in caches. Shared caches add it; clients subtract it from max-age to get the remaining freshness.",
    example: "Age: 118",
    note: "An Age that climbs past your max-age without a revalidation is a misconfigured CDN, not a fast one.",
    keywords: "cdn cache hit staleness",
  },
  {
    name: "Expires",
    dir: "res",
    purpose:
      "An absolute date after which the response is stale. The HTTP/1.0 way of saying max-age.",
    example: "Expires: Wed, 12 Aug 2026 09:14:00 GMT",
    note: "Ignored whenever Cache-Control max-age or s-maxage is present. Expires: 0 is the widespread non-conforming way to say 'already stale' — use no-cache instead.",
    flag: "legacy",
  },
  {
    name: "ETag",
    dir: "res",
    purpose:
      "An opaque version tag for this exact representation. The client hands it back to ask whether it is still current.",
    example: 'ETag: "3f8a1c-1a4"',
    note: "A W/ prefix marks it weak: fine for cache revalidation, useless for If-Match concurrency. Gzip and identity variants must not share a strong ETag.",
    keywords: "validator revalidation 304 etags",
  },
  {
    name: "Last-Modified",
    dir: "res",
    purpose:
      "When the representation last changed. The weaker validator, for when you have no ETag.",
    example: "Last-Modified: Tue, 11 Aug 2026 22:03:11 GMT",
    note: "One-second resolution, so two edits inside the same second are invisible. Also what caches use for heuristic freshness when you send no explicit lifetime.",
    keywords: "validator heuristic freshness",
  },
  {
    name: "If-None-Match",
    dir: "req",
    purpose:
      "Revalidation: send the body only if the ETag is none of these. A match gets a 304 with no body.",
    example: 'If-None-Match: "3f8a1c-1a4"',
    note: "Wins over If-Modified-Since when both are sent. Uses weak comparison, so W/ tags do match.",
    keywords: "304 not modified conditional get",
  },
  {
    name: "If-Modified-Since",
    dir: "req",
    purpose:
      "Date-based revalidation: send the body only if it changed after this timestamp.",
    example: "If-Modified-Since: Tue, 11 Aug 2026 22:03:11 GMT",
    note: "Only meaningful on GET and HEAD, and ignored entirely when If-None-Match is present.",
    keywords: "304 not modified conditional get",
  },
  {
    name: "Vary",
    dir: "res",
    purpose:
      "Names the request headers that were used to select this representation. In other words: the rest of the cache key.",
    example: "Vary: Accept-Encoding, Origin",
    note: "Omit one and a shared cache will happily hand a Brotli body to a client that cannot decode it, or one tenant's CORS headers to another. Vary: * means never reusable.",
    keywords: "cache key content negotiation poisoning",
  },
  {
    name: "CDN-Cache-Control",
    dir: "res",
    purpose:
      "Caching policy aimed at CDNs only. They obey it in place of Cache-Control; browsers ignore it completely.",
    example: "CDN-Cache-Control: max-age=31536000",
    note: "RFC 9213 targeted cache control. The clean way to cache hard at the edge and barely at all in the browser, without the usual s-maxage contortions.",
    keywords: "fastly cloudflare akamai targeted edge",
  },
  {
    name: "Surrogate-Control",
    dir: "res",
    purpose:
      "The pre-RFC vendor spelling of the same idea, still honoured by Varnish, Fastly and friends.",
    example: "Surrogate-Control: max-age=86400",
    flag: "de-facto",
    keywords: "varnish fastly edge",
  },
  {
    name: "Cache-Status",
    dir: "res",
    purpose:
      "How each cache in the path handled the request: hit or miss, remaining TTL, which node answered.",
    example: 'Cache-Status: "cdn"; hit; ttl=284',
    note: "RFC 9211. Standardises the pile of X-Cache headers every CDN invented separately.",
    keywords: "x-cache hit miss debug",
  },
  {
    name: "Pragma",
    dir: "req",
    purpose: "The HTTP/1.0 ancestor of Cache-Control, with one useful value.",
    example: "Pragma: no-cache",
    note: "Only ever defined for requests. Sending it on a response does nothing except make your headers longer.",
    flag: "legacy",
  },
  {
    name: "Warning",
    dir: "both",
    purpose: "Free-text notes about staleness and transformations.",
    example: 'Warning: 110 - "Response is Stale"',
    note: "Obsoleted by RFC 9111. Nothing generates it and nothing reads it.",
    flag: "dead",
  },
];

const DIRECTIVES: HeaderRow[] = [
  {
    name: "max-age=N",
    dir: "both",
    purpose:
      "On a response: fresh for N seconds, counted from when the origin generated it — not from when you received it. On a request: I will not accept anything older than N seconds.",
    example: "Cache-Control: max-age=600",
    note: "Age is what makes the origin-relative part work. A response that spent 500s in a CDN has 100s of freshness left, not 600.",
    keywords: "ttl freshness",
  },
  {
    name: "s-maxage=N",
    dir: "res",
    purpose:
      "Freshness for shared caches only — CDN, reverse proxy. Overrides both max-age and Expires for them, and leaves the browser on max-age.",
    example: "Cache-Control: max-age=60, s-maxage=86400",
    note: "Also implies proxy-revalidate, so a shared cache may not serve it stale once it expires.",
    keywords: "cdn shared cache proxy",
  },
  {
    name: "no-cache",
    dir: "both",
    purpose:
      "Store it, but never reuse it without asking the origin first. This is a revalidation rule, not a ban on caching.",
    example: "Cache-Control: no-cache",
    note: "A 304 costs one small round-trip and no body. This is usually the right answer for HTML.",
    keywords: "revalidate misunderstood",
  },
  {
    name: "no-store",
    dir: "both",
    purpose:
      "Do not write this to any storage, anywhere, in any form. The only directive that actually means do not cache.",
    example: "Cache-Control: no-store",
    note: "Correct for responses carrying credentials or personal data. Add private and no-cache too if you need to defeat ancient, buggy intermediaries.",
    keywords: "private data credentials security",
  },
  {
    name: "private",
    dir: "res",
    purpose:
      "Only a single-user cache — the browser — may store this. Shared caches must not.",
    example: "Cache-Control: private, no-store",
    note: "Not a security control. It is a request to well-behaved caches, and the body still passes in cleartext through anything terminating your TLS.",
    keywords: "shared cache browser",
  },
  {
    name: "public",
    dir: "res",
    purpose:
      "Storable even in the cases where it normally would not be — most usefully, when the request carried an Authorization header.",
    example: "Cache-Control: public, max-age=3600",
    note: "Redundant on an ordinary unauthenticated GET; that is already cacheable. Adding it out of habit to authenticated responses is how private data lands in a CDN.",
    keywords: "authorization shared cache",
  },
  {
    name: "must-revalidate",
    dir: "res",
    purpose:
      "Once stale, it must not be served again until the origin confirms it.",
    example: "Cache-Control: max-age=60, must-revalidate",
    note: "If the origin is unreachable the cache must return a 504 rather than a stale body. That is a correctness choice, and it costs you availability.",
    keywords: "stale 504 correctness",
  },
  {
    name: "proxy-revalidate",
    dir: "res",
    purpose: "must-revalidate, but binding only on shared caches.",
    example: "Cache-Control: max-age=600, proxy-revalidate",
    keywords: "cdn shared cache",
  },
  {
    name: "immutable",
    dir: "res",
    purpose:
      "The body at this URL will never change, so do not revalidate it even when the user hits reload.",
    example: "Cache-Control: max-age=31536000, immutable",
    note: "Only safe on content-hashed URLs like app.7f3c1d.js. Put it on /app.js and you will serve last week's bundle to people who have no way to fix it.",
    keywords: "assets fingerprint reload rfc 8246",
  },
  {
    name: "stale-while-revalidate=N",
    dir: "res",
    purpose:
      "For N seconds past expiry, serve the stale copy immediately and refresh it in the background.",
    example: "Cache-Control: max-age=60, stale-while-revalidate=600",
    note: "The largest latency win available in this whole field, for one line of config. The cost is that some users see a response up to N seconds out of date.",
    keywords: "swr latency rfc 5861 background refresh",
  },
  {
    name: "stale-if-error=N",
    dir: "res",
    purpose:
      "If the origin errors or times out, keep serving the stale copy for up to N seconds instead of passing the failure through.",
    example: "Cache-Control: max-age=60, stale-if-error=86400",
    note: "Free availability during an incident, and nothing to build. Note that must-revalidate cancels it.",
    keywords: "outage resilience rfc 5861",
  },
  {
    name: "no-transform",
    dir: "res",
    purpose:
      "Intermediaries must not recompress images, minify, or otherwise rewrite the payload.",
    example: "Cache-Control: no-transform",
    note: "Worth setting on anything signed, checksummed, or byte-exact — and on images where a carrier proxy would otherwise degrade them.",
    keywords: "proxy compression rewrite",
  },
  {
    name: "must-understand",
    dir: "res",
    purpose:
      "Store this only if the cache understands the caching rules for its status code.",
    example: "Cache-Control: must-understand, no-store",
    note: "Newer caches honour must-understand and may store; older ones see the no-store beside it and skip. A forward-compatibility trick, not an everyday directive.",
    keywords: "rfc 9111 status code",
  },
  {
    name: "only-if-cached",
    dir: "req",
    purpose: "Return the cached copy or a 504. Do not touch the network.",
    example: "Cache-Control: only-if-cached",
    note: "How offline modes and some service workers ask for a strictly local answer.",
    keywords: "offline service worker",
  },
  {
    name: "max-stale=N",
    dir: "req",
    purpose:
      "I will accept a response that has been stale for up to N seconds.",
    example: "Cache-Control: max-stale=300",
    keywords: "client staleness tolerance",
  },
  {
    name: "min-fresh=N",
    dir: "req",
    purpose:
      "I want a response that will still be fresh for at least another N seconds.",
    example: "Cache-Control: min-fresh=60",
    keywords: "client freshness",
  },
];

const CONDITIONAL: HeaderRow[] = [
  {
    name: "If-Match",
    dir: "req",
    purpose:
      "Only perform this write if the resource still carries one of these ETags. HTTP's compare-and-swap.",
    example: 'If-Match: "3f8a1c-1a4"',
    note: "A mismatch returns 412 Precondition Failed. Strong comparison, so a W/ tag never matches. This is how you stop two tabs silently overwriting each other.",
    keywords: "412 optimistic concurrency lost update put patch",
  },
  {
    name: "If-Unmodified-Since",
    dir: "req",
    purpose:
      "The dated version: only write if nothing has changed since this timestamp.",
    example: "If-Unmodified-Since: Tue, 11 Aug 2026 22:03:11 GMT",
    note: "Weaker than If-Match because of the one-second clock. Prefer ETags whenever you can generate them.",
    keywords: "412 concurrency",
  },
  {
    name: "Range",
    dir: "req",
    purpose: "Ask for specific byte ranges instead of the whole body.",
    example: "Range: bytes=0-1048575",
    note: "Answered with 206 and a Content-Range, or 416 if the range makes no sense. Multi-range requests are legal and mostly a denial-of-service vector — cap them.",
    keywords: "206 video seek resume partial download streaming",
  },
  {
    name: "Accept-Ranges",
    dir: "res",
    purpose:
      "Advertises that range requests work here. Two values in practice: bytes, or none.",
    example: "Accept-Ranges: bytes",
    note: "Without it, well-behaved download managers will not attempt a resume.",
    keywords: "resume download",
  },
  {
    name: "Content-Range",
    dir: "res",
    purpose:
      "On a 206: which bytes these are, and how large the whole thing is.",
    example: "Content-Range: bytes 0-1048575/7340032",
    note: "An unsatisfiable range gets a 416 plus Content-Range: bytes */7340032 so the client learns the real size.",
    keywords: "206 416 partial content",
  },
  {
    name: "If-Range",
    dir: "req",
    purpose:
      "Send the range only if the resource has not changed; otherwise send the whole thing.",
    example: 'If-Range: "3f8a1c-1a4"',
    note: "Saves a round-trip on a resumed download: you get a 206 if the file is untouched, a plain 200 if it is not, and never a corrupted splice.",
    keywords: "resume download 206",
  },
];

const CONTENT: HeaderRow[] = [
  {
    name: "Accept",
    dir: "req",
    purpose:
      "Media types the client can handle, with q-weights expressing preference.",
    example: "Accept: application/json;q=1.0, text/plain;q=0.5, */*;q=0.1",
    note: "If nothing matches, the honest answer is 406. Most APIs ignore this and always return JSON, which is fine — just do not also advertise negotiation you do not do.",
    keywords: "content negotiation 406 media type",
  },
  {
    name: "Accept-Encoding",
    dir: "req",
    purpose: "Compression formats the client understands.",
    example: "Accept-Encoding: gzip, br, zstd",
    note: "The reason Vary: Accept-Encoding is mandatory on anything you compress at the origin.",
    keywords: "gzip brotli zstd compression",
  },
  {
    name: "Accept-Language",
    dir: "req",
    purpose: "Preferred human languages, weighted.",
    example: "Accept-Language: en-GB, en;q=0.9, fr;q=0.7",
    note: "Serving different copy per language without Vary: Accept-Language is the classic way to show a French page to an English visitor straight out of the cache.",
    keywords: "i18n localisation content negotiation",
  },
  {
    name: "Accept-Charset",
    dir: "req",
    purpose: "Character encodings the client accepts.",
    example: "Accept-Charset: utf-8",
    note: "Deprecated in RFC 9110. Browsers stopped sending it years ago, and everything is UTF-8.",
    flag: "dead",
    keywords: "encoding utf-8",
  },
  {
    name: "Content-Type",
    dir: "both",
    purpose:
      "The media type of the body, plus parameters such as charset and multipart boundary.",
    example: "Content-Type: application/json; charset=utf-8",
    note: "Always send charset on text types. A JSON body sent with no Content-Type is the single most common cause of a mysterious 415.",
    keywords: "mime media type 415 charset",
  },
  {
    name: "Content-Encoding",
    dir: "res",
    purpose:
      "How the body was compressed. End-to-end: it stays compressed until the client decodes it.",
    example: "Content-Encoding: br",
    note: "Not the same thing as Transfer-Encoding, which is per-hop and can be undone by any proxy on the path.",
    keywords: "gzip brotli compression",
  },
  {
    name: "Content-Language",
    dir: "res",
    purpose:
      "Which language the body is in — the answer to Accept-Language, and one of the seven headers CORS exposes by default.",
    example: "Content-Language: en-GB",
    keywords: "i18n",
  },
  {
    name: "Content-Length",
    dir: "both",
    purpose: "Body size in bytes.",
    example: "Content-Length: 34871",
    note: "Sending Content-Length and Transfer-Encoding: chunked on the same HTTP/1.1 message is the foundation of request smuggling. A front end should reject that message, not pick a winner.",
    keywords: "smuggling chunked framing",
  },
  {
    name: "Content-Disposition",
    dir: "res",
    purpose: "Render inline or download, and what to call the file.",
    example: 'Content-Disposition: attachment; filename="q3-report.csv"',
    note: "For non-ASCII names use the filename* form with UTF-8 percent-encoding. Sanitise it either way — an unescaped filename is a header-injection hole.",
    keywords: "download attachment inline filename",
  },
  {
    name: "Content-Location",
    dir: "res",
    purpose:
      "The direct URL of the representation you just received, when it differs from the URL you asked for.",
    example: "Content-Location: /reports/q3.json",
    note: "Not Location, and it redirects nothing. Mixing the two up produces bugs that survive code review because the names look alike.",
    keywords: "representation url",
  },
  {
    name: "Content-Digest",
    dir: "both",
    purpose: "A checksum of the body, carried as a structured field.",
    example:
      "Content-Digest: sha-256=:X48E9qOokqqrvdts8nOJRJN3OWDUoyWxBf7kbu9DBPE=:",
    note: "RFC 9530, replacing the old Digest header. Useful on webhooks and uploads; compare in constant time when it feeds a signature check.",
    keywords: "integrity checksum webhook rfc 9530",
  },
  {
    name: "Transfer-Encoding",
    dir: "both",
    purpose:
      "How the message body was framed on this hop — in practice, chunked.",
    example: "Transfer-Encoding: chunked",
    note: "HTTP/1.1 only. Forbidden in HTTP/2 and HTTP/3, which do their own framing.",
    keywords: "chunked framing smuggling",
  },
  {
    name: "TE",
    dir: "req",
    purpose:
      "Transfer codings the client accepts on this hop, including trailer fields.",
    example: "TE: trailers",
    note: "Hop-by-hop, and one of the fields a smuggling-aware proxy should normalise rather than forward blindly.",
    keywords: "trailers hop-by-hop",
  },
  {
    name: "Allow",
    dir: "res",
    purpose: "The methods this resource supports. Required on a 405.",
    example: "Allow: GET, HEAD, PUT, OPTIONS",
    note: "A 405 without Allow leaves the caller guessing, which defeats the entire point of the status code.",
    keywords: "405 method not allowed options",
  },
  {
    name: "Location",
    dir: "res",
    purpose:
      "Where to go next: the redirect target on a 3xx, or the URL of the thing you just created on a 201.",
    example: "Location: /orders/1f9c2b",
    note: "A 201 without a Location is a half-finished API. So is a 202 that gives you nowhere to poll.",
    keywords: "redirect 301 302 201 created",
  },
  {
    name: "Link",
    dir: "res",
    purpose:
      "Typed relations to other URLs: pagination, preload, canonical, API discovery.",
    example:
      'Link: </orders?page=3>; rel="next", </app.css>; rel=preload; as=style',
    note: "Paired with a 103 Early Hints response, rel=preload buys you asset fetches while the origin is still assembling the real answer.",
    keywords: "pagination preload canonical early hints 103",
  },
];

const CORS: HeaderRow[] = [
  {
    name: "Origin",
    dir: "req",
    purpose:
      "Which origin the request came from. The browser sets it and page JavaScript cannot change it.",
    example: "Origin: https://app.example.com",
    note: "Sent on every cross-origin request and on same-origin POST too. It can legitimately be the literal string null — sandboxed iframes, some redirects — so never let null pass an allowlist check.",
    keywords: "cors preflight csrf",
  },
  {
    name: "Access-Control-Request-Method",
    dir: "req",
    purpose: "On a preflight: the method the real request is about to use.",
    example: "Access-Control-Request-Method: PATCH",
    note: "Only ever appears on the OPTIONS preflight, never on the request that follows it.",
    keywords: "cors preflight options",
  },
  {
    name: "Access-Control-Request-Headers",
    dir: "req",
    purpose:
      "On a preflight: the non-safelisted headers the real request wants to send.",
    example: "Access-Control-Request-Headers: authorization, content-type",
    note: "This is why adding one custom header to a fetch call suddenly doubles your request count.",
    keywords: "cors preflight options safelist",
  },
  {
    name: "Access-Control-Allow-Origin",
    dir: "res",
    purpose:
      "The single origin allowed to read this response — or the wildcard.",
    example: "Access-Control-Allow-Origin: https://app.example.com",
    note: "You may send one origin, never a list. Check the request Origin against your allowlist, echo it back, and add Vary: Origin the moment you do.",
    keywords: "cors acao wildcard allowlist",
  },
  {
    name: "Access-Control-Allow-Methods",
    dir: "res",
    purpose: "Preflight answer: which methods are permitted.",
    example: "Access-Control-Allow-Methods: GET, POST, PATCH, DELETE",
    note: "Only read on the preflight response. Sending it on real responses is harmless noise.",
    keywords: "cors preflight",
  },
  {
    name: "Access-Control-Allow-Headers",
    dir: "res",
    purpose: "Preflight answer: which request headers are permitted.",
    example:
      "Access-Control-Allow-Headers: Authorization, Content-Type, X-Request-Id",
    note: "The wildcard does not cover Authorization. If your clients send a bearer token, you have to name that header explicitly or the preflight fails.",
    keywords: "cors preflight authorization wildcard",
  },
  {
    name: "Access-Control-Allow-Credentials",
    dir: "res",
    purpose:
      "Lets the browser attach cookies and expose the response when the request used credentials: include.",
    example: "Access-Control-Allow-Credentials: true",
    note: "Illegal alongside a wildcard origin. Turn credentials on and every wildcard in the CORS set stops behaving as a wildcard.",
    keywords: "cors cookies credentials include",
  },
  {
    name: "Access-Control-Expose-Headers",
    dir: "res",
    purpose: "Which response headers JavaScript is allowed to read.",
    example:
      "Access-Control-Expose-Headers: RateLimit, X-Request-Id, Content-Digest",
    note: "Without it, fetch sees only seven safelisted headers: Cache-Control, Content-Language, Content-Length, Content-Type, Expires, Last-Modified, Pragma. Your custom header is visible in DevTools and absent in code.",
    keywords: "cors read headers fetch safelist",
  },
  {
    name: "Access-Control-Max-Age",
    dir: "res",
    purpose:
      "How long the browser may cache this preflight result, in seconds.",
    example: "Access-Control-Max-Age: 600",
    note: "The default is 5 seconds and browsers clamp the maximum — Chromium at 7200, Firefox at 86400. Anything larger is silently reduced, not honoured.",
    keywords: "cors preflight cache latency",
  },
  {
    name: "Timing-Allow-Origin",
    dir: "res",
    purpose:
      "Lets a cross-origin page read detailed timings and Server-Timing for this resource.",
    example: "Timing-Allow-Origin: https://app.example.com",
    note: "Nothing to do with access control; it only unlocks measurement. Without it, cross-origin Resource Timing entries are mostly zeroes.",
    keywords: "resource timing server-timing rum performance",
  },
];

const SECURITY: HeaderRow[] = [
  {
    name: "Strict-Transport-Security",
    dir: "res",
    purpose:
      "Forces HTTPS for this host for max-age seconds, with no click-through past certificate errors.",
    example:
      "Strict-Transport-Security: max-age=63072000; includeSubDomains; preload",
    note: "Ignored over plain HTTP by design. includeSubDomains covers hosts you forgot about; preload bakes you into browser binaries and is genuinely hard to undo. Ship a short max-age first.",
    keywords: "hsts https tls downgrade preload",
  },
  {
    name: "Content-Security-Policy",
