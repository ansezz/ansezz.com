  },
  {
    href: "/blog/forward-proxy-vs-reverse-proxy/",
    label: "Forward proxy vs reverse proxy",
    note: "Which box is adding X-Forwarded-For, and why the direction decides whether you can trust it.",
  },
  {
    href: "/blog/load-balancer-vs-reverse-proxy/",
    label: "Load balancer vs reverse proxy",
    note: "The hop that terminates TLS is the one that has to set X-Forwarded-Proto. Here is what sits where.",
  },
  {
    href: "/blog/rate-limiting-vs-throttling/",
    label: "Rate limiting vs throttling",
    note: "The design behind RateLimit and Retry-After: buckets, windows, and what a 429 should actually say.",
  },
  {
    href: "/tools/http-status-codes/",
    label: "HTTP Status Codes",
    note: "The other half of the response. Every 1xx to 5xx code and the headers each one obliges you to send.",
  },
  {
    href: "/tools/jwt-decoder/",
    label: "JWT Decoder",
    note: "Paste the token out of an Authorization header and read its claims, algorithm and expiry.",
  },
];

const relatedLinks = [
  {
    href: "/tools/http-status-codes/",
    note: "Codes and headers are the same lookup, split in two. Here's the other half.",
  },
  {
    href: "/blog/cdn-vs-cache/",
    note: "Cache-Control, Vary and Age decide what the edge is allowed to keep.",
  },
