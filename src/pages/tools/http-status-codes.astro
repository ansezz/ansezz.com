  },
  {
    code: "503",
    name: "Service Unavailable",
    meaning:
      "The service is temporarily unable to handle the request: overloaded, draining, starting up, or deliberately in maintenance.",
    use: "the condition is temporary and you know roughly for how long — pair it with Retry-After. It is the only 5xx that clients, CDNs, and crawlers are meant to treat as transient, which is why a maintenance window should return 503 and never 500 or 404.",
    keywords: "maintenance overload capacity retry-after draining shed",
  },
  {
    code: "504",
    name: "Gateway Timeout",
    meaning: "A proxy gave up waiting for the server behind it to respond.",
    use: "you are the proxy and upstream blew the timeout budget. A 504 landing at exactly 30 or 60 seconds is a configuration value, not a mystery — compare the gateway timeout with the application's own.",
