---
import Page from "@/layouts/Page.astro";
import NeoCard from "@/components/neobrutalist/NeoCard.astro";
import StickyNote from "@/components/neobrutalist/StickyNote.astro";
import ComparisonTable from "@/components/neobrutalist/ComparisonTable.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "@/consts";
import { breadcrumbList, faqPage } from "@/lib/seo";

const PAGE_TITLE = "HTTP Status Codes Reference";
const PAGE_DESCRIPTION =
  "HTTP status codes reference: every 1xx–5xx code, what it means, and when to use it, including the non-standard ones. Free, filterable, runs in your browser.";

const breadcrumbLd = breadcrumbList([
  { name: "Home", url: SITE.URL },
  { name: "Tools", url: "/tools/" },
  { name: PAGE_TITLE, url: "/tools/http-status-codes/" },
]);

type Flag = "webdav" | "rare" | "deprecated" | "reserved" | "non-standard";

interface StatusCode {
  code: string;
  name: string;
  meaning: string;
  /** Reads after the words "Use it when" — start lowercase. */
  use: string;
  flag?: Flag;
  /** Extra search terms for the filter box; never rendered. */
  keywords?: string;
}

const FLAG_LABEL: Record<Flag, string> = {
  webdav: "WebDAV",
  rare: "Rare",
  deprecated: "Deprecated",
  reserved: "Reserved",
  "non-standard": "Non-standard",
};

const FLAG_CLASS: Record<Flag, string> = {
  webdav: "bg-cyan",
  rare: "bg-bg-alt",
  deprecated: "bg-yellow",
  reserved: "bg-bg-alt",
  "non-standard": "bg-pink",
};

const ONE_XX: StatusCode[] = [
  {
    code: "100",
    name: "Continue",
    meaning:
      "The server has read the request headers and is willing to take the body. A final status still follows on the same request.",
    use: "you never write it by hand. It exists so a client that sent Expect: 100-continue can avoid uploading two gigabytes before learning the request would be rejected.",
    keywords: "expect continue upload",
  },
  {
    code: "101",
    name: "Switching Protocols",
    meaning:
      "The connection is leaving HTTP for whatever the Upgrade header named — in practice, WebSocket.",
    use: "a protocol handshake, and only from the server side. Over HTTP/2 and HTTP/3 WebSockets use extended CONNECT instead, so you will never see a 101 there.",
    keywords: "websocket upgrade handshake",
  },
  {
    code: "102",
    name: "Processing",
    meaning:
      "The server is still working on a long WebDAV operation and wants the client to keep waiting.",
    use: "essentially never. It only ever applied to WebDAV, and 103 covers the useful half of the idea.",
    flag: "webdav",
    keywords: "long running",
  },
  {
    code: "103",
    name: "Early Hints",
    meaning:
      "A preliminary response carrying Link headers so the browser can start fetching CSS, fonts, and scripts while the origin is still generating the real response.",
    use: "your time-to-first-byte is dominated by slow server work and you know the critical assets up front. Cloudflare and Fastly can synthesise it for you; browsers only act on it for navigation requests.",
    keywords: "preload preconnect performance ttfb link",
  },
];

const TWO_XX: StatusCode[] = [
  {
    code: "200",
    name: "OK",
    meaning:
      "The request succeeded and the body, if there is one, is the result.",
    use: "the operation fully succeeded and you are handing back a representation. Not when it half-worked, and never with an error object inside.",
    keywords: "success ok",
  },
  {
    code: "201",
    name: "Created",
    meaning:
      "A new resource now exists. The response should carry a Location header pointing at it, and usually the new representation as the body.",
    use: "a POST or PUT created something addressable — POST /orders that returns order 1234. If nothing was created and you only queued work, that is a 202.",
    keywords: "post create location new resource",
  },
  {
    code: "202",
    name: "Accepted",
    meaning:
      "The request was valid and has been queued. Nothing has actually happened yet, and it might still fail.",
    use: "async work: you enqueued a job, sent it to a worker, or handed it to a batch pipeline. Always return somewhere to poll — a Location header or a status URL in the body. A bare 202 tells the client nothing it can act on.",
    keywords: "async queue job background webhook polling",
  },
  {
    code: "203",
    name: "Non-Authoritative Information",
    meaning:
      "Success, but a transforming proxy in the middle modified the payload, so it is not exactly what the origin sent.",
    use: "you are writing a proxy that rewrites responses. Applications do not emit this.",
    flag: "rare",
    keywords: "proxy transform",
  },
  {
    code: "204",
    name: "No Content",
    meaning:
      "Success, and there is deliberately nothing to send. A 204 must not carry a body at all.",
    use: "DELETE succeeded, a PUT saved with nothing worth returning, a preference toggle. Two traps: a browser navigating to a 204 stays on the current page, and fetch's response.json() throws on it. If the caller needs data, return 200 with a body instead.",
    keywords: "delete empty body no content put",
  },
  {
    code: "205",
    name: "Reset Content",
    meaning:
      "Success, and the client should reset the form or document view that sent the request. Also forbidden from carrying a body.",
    use: "almost never outside legacy form workflows. Modern front ends reset their own state.",
    flag: "rare",
    keywords: "form reset",
  },
  {
    code: "206",
    name: "Partial Content",
    meaning:
      "Here is the byte range that was asked for. Requires a Content-Range header describing what was sent.",
    use: "range requests — video seeking, resumable downloads, byte-serving PDFs. Your CDN and static file server do this; you rarely hand-write it.",
    keywords: "range video streaming resume download",
  },
  {
    code: "207",
    name: "Multi-Status",
    meaning:
      "One response body carrying a separate status for each of several resources.",
    use: "WebDAV. It is also the honest answer for a batch endpoint where individual operations can fail independently — but if you invent your own envelope, do not label it 207.",
    flag: "webdav",
    keywords: "batch bulk multiple",
  },
  {
    code: "208",
    name: "Already Reported",
    meaning:
      "Inside a 207 body: this resource was already enumerated earlier in the response, so it is not repeated.",
    use: "WebDAV collections only.",
    flag: "webdav",
  },
  {
    code: "226",
    name: "IM Used",
    meaning:
      "The response is a delta against a version the client already has, per the instance-manipulation extension in RFC 3229.",
    use: "practically never — almost nothing implements delta encoding.",
    flag: "rare",
    keywords: "delta encoding",
  },
];

