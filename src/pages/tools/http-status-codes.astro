    keywords: "exception crash bug unhandled error",
  },
  {
    code: "501",
    name: "Not Implemented",
    meaning:
      "The server does not support the method at all, anywhere — not merely on this URL.",
    use: "a gateway meets a verb it has never heard of. If the method exists but not on this route, that is 405.",
    keywords: "method unsupported gateway verb",
  },
  {
    code: "502",
    name: "Bad Gateway",
    meaning:
      "A proxy received an invalid, empty, or unparseable response from the server behind it.",
    use: "you are the proxy. From outside, a 502 almost always means the app crashed, refused the connection, or wrote garbage — check the application logs, not the proxy's.",
