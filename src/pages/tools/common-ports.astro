    keywords: "nats jetstream messaging monitor cluster",
  },
  {
    port: "1883 · 8883",
    proto: "TCP",
    service: "MQTT · MQTT over TLS",
    note: "1883 is plaintext. Mosquitto allowed anonymous publish by default for years, which is how strangers ended up toggling other people's devices.",
    keywords: "mqtt mosquitto iot broker emqx telemetry",
  },
];

