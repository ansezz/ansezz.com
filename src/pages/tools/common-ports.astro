    keywords: "kafka kraft controller tls sasl listener",
  },
  {
    port: "2181",
    proto: "TCP",
    service: "ZooKeeper",
    note: "Client port for pre-KRaft Kafka, HBase and friends. Peer traffic is 2888 and leader election 3888, and all three need to be open between ensemble members.",
    keywords: "zookeeper ensemble quorum kafka hbase",
  },
  {
    port: "4222 · 6222 · 8222",
    proto: "TCP",
    service: "NATS client · route · monitoring",
