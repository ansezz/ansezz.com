    keywords: "redis valkey cache kv memory elasticache session",
  },
  {
    port: "26379",
    proto: "TCP",
    service: "Redis Sentinel",
    note: "Failover coordination. Clients ask Sentinel who the master is, so when this is unreachable your app fails over to nothing at all.",
    keywords: "redis sentinel failover ha master replica",
  },
  {
    port: "16379",
    proto: "TCP",
    service: "Redis cluster bus",
    note: "Always the data port plus 10000. Open 6379 between nodes but not 16379 and the cluster never finishes forming — the classic first-cluster bug.",
    keywords: "redis cluster bus gossip shard slots",
  },
  {
    port: "11211",
    proto: "TCP/UDP",
    service: "Memcached",
    note: "No authentication in the default build. Its UDP listener drove the 1.3 Tbps amplification attacks of 2018 and now ships disabled — check anything older than that.",
    flag: "never-public",
    keywords: "memcached cache amplification ddos udp",
  },
  {
    port: "5672 · 5671",
    proto: "TCP",
    service: "RabbitMQ AMQP · AMQPS",
    note: "5671 is the TLS listener. Publisher confirms and consumer acks are what make delivery reliable — an open port only proves the socket works.",
    keywords: "rabbitmq amqp queue broker messaging celery",
  },
  {
    port: "15672",
    proto: "TCP",
    service: "RabbitMQ management UI",
    note: "guest/guest is restricted to loopback, but a reverse proxy on the same host makes every request look like loopback. That is how an exposed dashboard becomes an open one.",
    flag: "never-public",
    keywords: "rabbitmq management dashboard ui guest plugin",
  },
  {
    port: "15692",
    proto: "TCP",
    service: "RabbitMQ Prometheus metrics",
    note: "From the rabbitmq_prometheus plugin. Scrape this instead of polling the management HTTP API, which gets expensive on a vhost with thousands of queues.",
