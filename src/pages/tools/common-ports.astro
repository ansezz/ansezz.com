---
import Page from "@/layouts/Page.astro";
import RelatedLinks from "@/components/RelatedLinks.astro";
import NeoCard from "@/components/neobrutalist/NeoCard.astro";
import StickyNote from "@/components/neobrutalist/StickyNote.astro";
import CodeBlock from "@/components/neobrutalist/CodeBlock.astro";
import ComparisonTable from "@/components/neobrutalist/ComparisonTable.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "@/consts";
import { breadcrumbList, faqPage } from "@/lib/seo";

const PAGE_TITLE = "Common Ports Reference";
const PAGE_DESCRIPTION =
  "Free TCP and UDP port reference: web, databases, caches, Docker, Kubernetes, mail and dev servers, each with a practical note. Filter it all in your browser.";

const breadcrumbLd = breadcrumbList([
  { name: "Home", url: SITE.URL },
  { name: "Tools", url: "/tools/" },
  { name: PAGE_TITLE, url: "/tools/common-ports/" },
]);

type Flag = "never-public" | "legacy" | "local";

interface PortRow {
  /** May list several related ports, separated by a middot. */
  port: string;
  proto: "TCP" | "UDP" | "TCP/UDP";
  service: string;
  note: string;
  flag?: Flag;
  /** Extra search terms for the filter box; never rendered. */
  keywords?: string;
}

const FLAG_LABEL: Record<Flag, string> = {
  "never-public": "Never public",
  legacy: "Legacy",
  local: "Local only",
};

const FLAG_CLASS: Record<Flag, string> = {
  "never-public": "bg-pink",
  legacy: "bg-yellow",
  local: "bg-bg-alt",
};

const WEB: PortRow[] = [
  {
    port: "80",
    proto: "TCP",
    service: "HTTP",
    note: "Plaintext. Its only honest job now is a 301 to 443 — an API that still serves real responses here is handing bearer tokens to whoever owns the café Wi-Fi.",
    keywords: "http web plaintext redirect nginx apache",
  },
  {
    port: "443",
    proto: "TCP/UDP",
    service: "HTTPS · HTTP/3 (QUIC)",
    note: "TLS over TCP, and QUIC over UDP for HTTP/3. When HTTP/3 silently never negotiates, it is almost always UDP/443 dropped by a firewall someone only ever wrote a TCP rule for.",
    keywords: "https tls ssl quic http3 web secure",
  },
  {
    port: "8080",
    proto: "TCP",
    service: "HTTP alternate",
    note: "Tomcat, Spring Boot, Jenkins, cAdvisor, Weaviate and the Traefik dashboard all want it. The most over-subscribed number on any developer laptop.",
    keywords: "tomcat spring jenkins traefik proxy alternate cadvisor",
  },
  {
    port: "8443",
    proto: "TCP",
    service: "HTTPS alternate",
    note: "The TLS twin of 8080. Unprivileged, so a JVM or an ingress controller can bind it without root — which is exactly why it exists.",
    keywords: "https tls alternate ingress tomcat appliance",
  },
  {
    port: "3128",
    proto: "TCP",
    service: "Squid forward proxy",
    note: "The classic corporate egress proxy. If a container resolves DNS fine but every outbound request hangs, check whether HTTPS_PROXY should be pointing here.",
    keywords: "squid proxy egress corporate http_proxy forward",
  },
  {
    port: "1080",
    proto: "TCP",
    service: "SOCKS proxy",
    note: "SOCKS5. ssh -D 1080 user@bastion gives you one for free, and it is the cheapest way to reach a private subnet from a laptop without provisioning a VPN.",
    keywords: "socks socks5 tunnel ssh dynamic bastion",
  },
  {
    port: "2019",
    proto: "TCP",
    service: "Caddy admin API",
    note: "Loopback by default, and it must stay there: anyone who reaches it can rewrite the entire config and get certificates issued for any hostname you control.",
    flag: "local",
    keywords: "caddy admin config api reverse proxy",
  },
];

const DATABASES: PortRow[] = [
  {
    port: "3306",
    proto: "TCP",
    service: "MySQL · MariaDB",
    note: "The classic protocol. Exposed to the internet it gets credential-stuffed continuously — bind it to a private address and let the app reach it inside the VPC.",
    flag: "never-public",
    keywords: "mysql mariadb percona sql database rds",
  },
  {
    port: "33060",
    proto: "TCP",
    service: "MySQL X Protocol",
    note: "MySQL 8's document protocol, enabled by default. People firewall 3306, forget this exists, and leave the same server reachable through the side door.",
    flag: "never-public",
    keywords: "mysqlx document protocol mysql shell 8",
  },
  {
    port: "5432",
    proto: "TCP",
    service: "PostgreSQL",
    note: "listen_addresses and pg_hba.conf are two independent gates. Opening the port without a matching pg_hba line only changes which error you get.",
    flag: "never-public",
    keywords: "postgres postgresql pgsql database supabase neon",
  },
  {
    port: "6432",
    proto: "TCP",
    service: "PgBouncer",
    note: "The pooler that fronts 5432. Past a few hundred clients your app should talk to this instead — and remember transaction mode breaks session state and server-side prepared statements.",
    keywords: "pgbouncer pooler postgres connection pool pgcat",
  },
  {
    port: "1433",
    proto: "TCP",
    service: "Microsoft SQL Server",
    note: "The default instance. Named instances get dynamic ports and are found through 1434/UDP, which is why so many SQL Server firewall rules are subtly wrong.",
    flag: "never-public",
    keywords: "mssql sqlserver tds azure sql database",
  },
  {
    port: "1434",
    proto: "UDP",
    service: "SQL Server Browser",
