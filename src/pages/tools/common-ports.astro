  },
  {
    port: "1521",
    proto: "TCP",
    service: "Oracle TNS listener",
    note: "The listener, not the database. It can redirect a client to another port entirely, so one firewall rule for 1521 is frequently not enough.",
    flag: "never-public",
    keywords: "oracle tns listener database sqlnet",
  },
  {
    port: "27017",
    proto: "TCP",
    service: "MongoDB",
    note: "Binds localhost by default since 3.6 — the ransom-note era came from builds that did not. Verify with ss rather than trusting whatever your distro packaged.",
    flag: "never-public",
    keywords: "mongo mongodb nosql document atlas",
  },
  {
    port: "27018 · 27019",
    proto: "TCP",
    service: "MongoDB shard · config server",
    note: "Shard members and config servers in a sharded cluster. Cluster-internal traffic only; nothing outside should ever dial these.",
    keywords: "mongodb sharding config replica set mongos",
  },
  {
    port: "9042",
    proto: "TCP",
    service: "Cassandra · ScyllaDB (CQL)",
    note: "The client protocol. Inter-node gossip runs on 7000, or 7001 with TLS, and it has to be open between nodes or the ring never forms.",
    keywords: "cassandra scylla cql gossip ring datastax",
  },
  {
    port: "8123 · 9000",
    proto: "TCP",
    service: "ClickHouse HTTP · native",
    note: "9000 is the fast native protocol, and it collides with php-fpm, MinIO and Portainer. On a shared box, somebody is moving.",
    keywords: "clickhouse olap analytics native http columnar",
  },
  {
    port: "9200 · 9300",
    proto: "TCP",
    service: "Elasticsearch · OpenSearch",
    note: "9200 is the REST API, 9300 the inter-node transport. An open, unauthenticated 9200 is still one of the most-indexed data leaks on Shodan.",
    flag: "never-public",
    keywords: "elastic elasticsearch opensearch search elk lucene index",
  },
  {
    port: "7687 · 7474",
    proto: "TCP",
    service: "Neo4j Bolt · HTTP",
    note: "Bolt is the binary driver protocol, 7474 the browser UI. Change the default password before that container lives anywhere but your laptop.",
    keywords: "neo4j bolt graph cypher database",
  },
  {
    port: "6333 · 6334",
    proto: "TCP",
    service: "Qdrant REST · gRPC",
    note: "Vector store. The API key is opt-in, so an unset key means anyone who reaches 6333 can read — and quietly rewrite — your embeddings.",
    keywords: "qdrant vector embeddings rag similarity search",
  },
  {
    port: "19530",
    proto: "TCP",
    service: "Milvus",
    note: "The gRPC endpoint for the vector database; 9091 serves metrics and health, which collides with the Prometheus Pushgateway.",
    keywords: "milvus vector embeddings rag ann index",
  },
];

const CACHES: PortRow[] = [
  {
    port: "6379",
    proto: "TCP",
    service: "Redis · Valkey",
    note: "The most abused open port on the internet. An unauthenticated instance is a write primitive: CONFIG SET dir, SAVE, and your authorized_keys file belongs to someone else.",
