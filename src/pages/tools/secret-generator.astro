---
import Page from "@/layouts/Page.astro";
import RelatedLinks from "@/components/RelatedLinks.astro";
import NeoCard from "@/components/neobrutalist/NeoCard.astro";
import NeoButton from "@/components/neobrutalist/NeoButton.astro";
import StickyNote from "@/components/neobrutalist/StickyNote.astro";
import ComparisonTable from "@/components/neobrutalist/ComparisonTable.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "@/consts";
import { breadcrumbList, faqPage } from "@/lib/seo";

const TOOL_NAME = "Secret & API Key Generator";
const TOOL_PATH = "/tools/secret-generator/";
const DESCRIPTION =
  "Free secret and API key generator. Cryptographically secure hex, base64url, alphanumeric, and passphrase values with an entropy readout, in your browser.";

const breadcrumbLd = breadcrumbList([
  { name: "Home", url: SITE.URL },
  { name: "Tools", url: "/tools/" },
  { name: TOOL_NAME, url: TOOL_PATH },
]);

const presets = [
  { id: "custom", label: "Custom" },
  { id: "hex", label: "Hex 32" },
  { id: "base64url", label: "Base64url 32" },
  { id: "alphanumeric", label: "Alphanumeric 32" },
  { id: "appsecret", label: "App secret · 64 hex" },
  { id: "passphrase", label: "Passphrase" },
];

const charsets = [
  { id: "secret-lower", label: "Lowercase", hint: "a–z", checked: true },
  { id: "secret-upper", label: "Uppercase", hint: "A–Z", checked: true },
  { id: "secret-digits", label: "Digits", hint: "0–9", checked: true },
  { id: "secret-symbols", label: "Symbols", hint: "!#$%…~", checked: false },
];

const faq = [
  {
    q: "Is it safe to generate secrets in a browser?",
    a: "Yes, as long as the generator uses the platform CSPRNG and never sends the value anywhere. This page calls crypto.getRandomValues, which is backed by the same operating-system entropy source your server reaches for, and the generated values never leave the tab — no network request, no analytics event, no logging. Open devtools and watch the network panel while you click Generate. For a root signing key on a hardened host, generating on that host with openssl rand is still the tighter move.",
  },
  {
    q: "Why is Math.random() unsafe for passwords and API keys?",
    a: "Math.random() is a fast non-cryptographic PRNG — V8 implements it as xorshift128+ — seeded once when the context is created and never reseeded. Its internal state can be recovered from a modest run of outputs, and once an attacker has the state they can compute every value it will ever return, forwards and backwards. That is fine for shuffling a carousel and catastrophic for a session token, a password-reset link, or an API key.",
  },
  {
    q: "How many bits of entropy does an API key need?",
    a: "128 bits is the standard bar and there is very little reason to exceed it. That is 32 hex characters, 22 alphanumeric characters, or 16 raw bytes. Below roughly 64 bits you are inside reach of a determined offline attacker with commodity GPUs; above 128 you are only making your .env line longer, because the realistic compromise is the key leaking, not the key being guessed.",
  },
  {
    q: "What is modulo bias, and does this generator avoid it?",
    a: "Modulo bias is what you get when you map a random byte onto an alphabet that does not divide 256 evenly. With a 62-character alphabet, 256 = 4 × 62 + 8, so the first eight characters come up five times per 256 bytes while the rest come up four — about 25% more often. This tool computes limit = Math.floor(256 / alphabetSize) * alphabetSize, discards every byte at or above that limit, and only then takes the modulo, so each character is exactly equally likely.",
  },
  {
    q: "Are the passphrases here as strong as Diceware?",
    a: "No, and I would rather say so on the page than let you assume otherwise. The wordlist embedded here is 128 words, which is exactly 7 bits per word, so an eight-word passphrase is 56 bits. The EFF Diceware list is 7,776 words — about 12.9 bits per word — so six Diceware words beat eleven words from this list. Use passphrase mode for things a human has to type and remember, and random-string mode for anything a machine reads.",
  },
  {
    q: "Where should I store the secret after generating it?",
    a: "In a secret manager — Vault, AWS Secrets Manager, Doppler, 1Password, or your platform's encrypted environment store — and nowhere else. Not in the repository, not in a Slack message, not in a ticket. If a secret has ever touched shell history, a screen share, or a chat log, treat it as burned and rotate it. Rotation only works if your verifier accepts the old and the new value during an overlap window, so build that before you need it.",
  },
];

const appLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: TOOL_NAME,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any (browser)",
  url: new URL(TOOL_PATH, SITE.URL).href,
  description: DESCRIPTION,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  isAccessibleForFree: true,
  browserRequirements: "Requires JavaScript",
  author: { "@id": `${SITE.URL}#person` },
};

const faqLd = faqPage(faq.map((f) => ({ question: f.q, answer: f.a })));

const related = [
  {
    href: "/tools/uuid-generator/",
    kind: "Tool",
    title: "UUID Generator",
    blurb: "Same CSPRNG, different shape — v4 UUIDs in bulk.",
    icon: "lucide:fingerprint",
  },
  {
    href: "/tools/hash-generator/",
    kind: "Tool",
    title: "Hash Generator",
    blurb: "SHA-256 and friends, for when you need to store a digest instead.",
    icon: "lucide:hash",
  },
  {
    href: "/blog/coolify-self-hosted-saas/",
    kind: "Article",
    title: "Self-hosting a SaaS on Coolify",
    blurb: "Where environment secrets actually live once you leave Heroku.",
    icon: "lucide:server",
  },
  {
    href: "/blog/api-gateway-ai-stack/",
    kind: "Article",
    title: "The API gateway in an AI stack",
    blurb: "Where API keys get issued, scoped, and revoked.",
    icon: "lucide:route",
  },
];

const codeCls =
  "bg-ink text-bg rounded-[2px] px-1.5 py-0.5 font-mono text-[0.85em] font-semibold";
const linkCls =
  "font-bold underline decoration-[3px] underline-offset-4 hover:bg-yellow";
const h2Cls = "display text-2xl uppercase pt-4";

const relatedLinks = [
  {
    href: "/tools/hash-generator/",
    note: "Generate the secret here, store only its hash.",
  },
  {
    href: "/tools/uuid-generator/",
    note: "A UUID is an identifier, not a secret — it is not generated to resist guessing.",
  },
  {
    href: "/blog/rate-limiting-ai-wallet/",
    note: "A leaked key on a metered AI endpoint is a billing incident, not just an auth one.",
    kind: "Post" as const,
  },
];
---

<Page
  title={TOOL_NAME}
  description={DESCRIPTION}
  eyebrow="Free tool"
  heading="Secret & API Key Generator."
  intro="Cryptographically secure secrets, API keys, and passphrases — drawn from crypto.getRandomValues, never Math.random. Nothing is transmitted, nothing is logged."
  structuredData={[breadcrumbLd, appLd, faqLd]}
>
  <section class="mx-auto max-w-4xl px-5 pb-6">
    <StickyNote tone="green" tilt={-1.5} class="max-w-md">
      <p class="mono mb-1 text-[10px] font-bold tracking-widest uppercase">
        ▸ Local only
      </p>
      <p class="text-sm leading-snug font-bold">
        Generated in this tab with the browser CSPRNG. No request is made, no
        value is stored. Reload the page and they are gone for good.
      </p>
    </StickyNote>
  </section>

  <!-- TOOL -->
  <section class="mx-auto max-w-4xl px-5 pb-16" id="secret-root">
    <NeoCard tone="paper" shadow="md" class="space-y-6">
      <!-- Presets -->
      <div>
        <p
          class="mono mb-2 block text-[11px] font-bold tracking-widest uppercase"
        >
          Preset
        </p>
        <div class="flex flex-wrap gap-2">
          {
            presets.map((p) => (
              <button
                type="button"
                data-secret-preset={p.id}
                aria-pressed="false"
                class="mono border-ink bg-bg-alt shadow-neo-xs hover:bg-yellow hover:shadow-neo-sm rounded-full border-[2px] px-3 py-1 text-[10px] font-bold tracking-widest uppercase transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
              >
                {p.label}
              </button>
            ))
          }
        </div>
      </div>

      <!-- Random-string controls -->
      <div id="secret-string-controls" class="space-y-5">
        <div>
          <label
            for="secret-length"
            class="mono mb-2 block text-[11px] font-bold tracking-widest uppercase"
          >
            Length — <output id="secret-length-out" for="secret-length"
              >32</output
            > characters
          </label>
          <input
            id="secret-length"
            type="range"
            min="8"
            max="128"
            step="1"
            value="32"
            class="accent-pink w-full"
          />
          <div
            class="mono flex justify-between text-[10px] font-bold tracking-widest uppercase opacity-60"
          >
            <span>8</span>
            <span>128</span>
          </div>
        </div>

        <fieldset id="secret-charset-set" class="m-0 border-0 p-0">
          <legend
            class="mono mb-2 text-[11px] font-bold tracking-widest uppercase"
          >
            Character sets
          </legend>
          <div class="grid gap-2.5 sm:grid-cols-2">
            {
              charsets.map((c) => (
                <label
                  for={c.id}
                  class="flex cursor-pointer items-center gap-2 text-sm font-bold"
                >
                  <input
                    id={c.id}
                    type="checkbox"
                    checked={c.checked}
                    class="accent-pink border-ink h-6 w-6 border-[2.5px]"
                  />
                  <span>
                    {c.label} <span class="mono opacity-60">{c.hint}</span>
                  </span>
                </label>
              ))
            }
          </div>
          <p
            id="secret-charset-note"
            class="mono mt-2 text-[10px] tracking-widest uppercase opacity-60"
          >
          </p>
        </fieldset>
      </div>

      <!-- Passphrase controls -->
      <div id="secret-passphrase-controls" class="space-y-3" hidden>
        <label
          for="secret-words"
          class="mono mb-2 block text-[11px] font-bold tracking-widest uppercase"
        >
          Words — <output id="secret-words-out" for="secret-words">8</output> per
          passphrase
        </label>
        <input
          id="secret-words"
          type="range"
          min="3"
          max="12"
          step="1"
          value="8"
          class="accent-pink w-full"
        />
        <p class="mono text-[10px] tracking-widest uppercase opacity-60">
          128-word list · exactly 7 bits per word · joined with dashes
        </p>
      </div>

      <!-- Actions -->
      <div
        class="border-ink flex flex-wrap items-end gap-4 border-t-[2.5px] pt-5"
      >
        <label class="block">
          <span
            class="mono mb-2 block text-[11px] font-bold tracking-widest uppercase"
          >
            How many
          </span>
          <input
            id="secret-count"
            type="number"
            min="1"
            max="50"
            value="5"
            class="border-ink bg-paper shadow-neo-sm w-24 rounded-[4px] border-[3px] px-3 py-2.5 font-mono font-bold focus:outline-none"
          />
        </label>
        <NeoButton
          type="button"
          variant="primary"
          size="md"
          class="cursor-pointer"
          ariaLabel="Generate a fresh set of secrets"
        >
          <span id="secret-generate" class="inline-flex items-center gap-2">
            <Icon name="lucide:refresh-cw" class="h-4 w-4" aria-hidden="true" />
            Generate
          </span>
        </NeoButton>
        <button
          type="button"
          id="secret-copy"
          class="border-ink bg-paper shadow-neo-sm hover:bg-yellow hover:shadow-neo-md inline-flex items-center gap-2 border-[3px] px-4 py-2.5 text-sm font-bold tracking-wide uppercase transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
        >
          <Icon name="lucide:copy" class="h-4 w-4" aria-hidden="true" />
          <span id="secret-copy-label">Copy all</span>
        </button>
      </div>

      <p
        id="secret-error"
        class="text-accent-text text-sm font-bold"
        role="status"
        hidden
      >
      </p>
    </NeoCard>

    <!-- Output -->
    <NeoCard tone="green" shadow="lg" class="mt-6 space-y-4">
      <label
        for="secret-output"
        class="mono block text-[11px] font-bold tracking-widest uppercase"
      >
        ▸ Generated secrets
      </label>
      <textarea
        id="secret-output"
        rows="5"
        readonly
        spellcheck="false"
        class="border-ink bg-paper shadow-neo-sm w-full resize-y rounded-[4px] border-[3px] p-3 font-mono text-sm break-all focus:outline-none"
      ></textarea>

      <div
        aria-live="polite"
        class="border-ink grid gap-3 border-t-[2.5px] pt-4 sm:grid-cols-[auto_1fr] sm:items-center"
      >
        <p class="display text-4xl leading-none">
          <span id="secret-entropy">0</span><span class="text-xl"> bits</span>
        </p>
        <div class="space-y-1">
          <p class="text-sm">
            <span class="mono text-[10px] tracking-widest uppercase opacity-70"
              >Strength ·</span
            >
            <span id="secret-strength" class="font-bold">—</span>
          </p>
          <p id="secret-formula" class="mono text-[11px] opacity-80">—</p>
        </div>
        <p
          class="border-ink mono border-t-[2px] pt-3 text-[11px] break-all opacity-70 sm:col-span-2"
        >
          Alphabet: <span id="secret-alphabet">—</span>
        </p>
      </div>
    </NeoCard>
  </section>

  <!-- EXPLAINER -->
  <section class="mx-auto max-w-3xl px-5 pb-10">
    <div class="space-y-4 text-base leading-relaxed">
      <h2 class={h2Cls}>
        The randomness comes from the OS, not from JavaScript
      </h2>
      <p>
        <code class={codeCls}>crypto.getRandomValues()</code> is not a JavaScript
        random number generator. It is a thin wrapper over the platform CSPRNG —
        <code class={codeCls}>getrandom(2)</code> on Linux,
        <code class={codeCls}>BCryptGenRandom</code> on Windows,
        <code class={codeCls}>SecRandomCopyBytes</code> on macOS — the same source
        your server reaches for when it runs <code class={codeCls}
          >openssl rand</code
        >. It is seeded from hardware entropy, it is continuously reseeded by
        the kernel, and its output does not leak its internal state.
      </p>
      <p>
        <code class={codeCls}>Math.random()</code> fails all three of those. V8 implements
        it as xorshift128+, seeded once when the context is created and never reseeded.
        Its 128-bit state is recoverable from a modest run of consecutive outputs,
        and once you have the state you can compute every value it will ever return
        — forwards and backwards. That is fine for a confetti animation and a full
        compromise for a session token. This page never calls it. Not for the strings,
        not for the passphrases, not for anything.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-10">
    <ComparisonTable
      columns={[
        { label: "Math.random()", tone: "red" },
        { label: "crypto.getRandomValues()", tone: "green" },
      ]}
      rows={[
        {
          icon: "lucide:cpu",
          label: "Source",
          cells: ["xorshift128+ in V8", "OS CSPRNG"],
        },
        {
          icon: "lucide:eye",
          label: "State recoverable from output",
          cells: ["Yes — a short run is enough", "No"],
        },
        {
          icon: "lucide:refresh-ccw",
          label: "Reseeded",
          cells: ["Once, at context creation", "Continuously, by the kernel"],
        },
        {
          icon: "lucide:scale",
          label: "Uniform after % n",
          cells: ["No", "No — still needs rejection sampling"],
        },
        {
          icon: "lucide:shield",
          label: "Safe for secrets",
          cells: [false, true],
        },
      ]}
    />
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-10">
    <div class="space-y-4 text-base leading-relaxed">
      <h2 class={h2Cls}>
        Why plain <code class={codeCls}>byte % length</code> is a bug
      </h2>
      <p>
        A <code class={codeCls}>Uint8Array</code> gives you values 0–255, and your
        alphabet is almost never a divisor of 256. Take 62 alphanumeric characters:
        256 = 4 × 62 + 8. Bytes 0–7 land on the same index as bytes 62–69, 124–131,
        186–193 <em>and</em> 248–255 — five routes each — while every other index
        has only four. The first eight characters of your alphabet show up roughly
        25% more often than the rest.
      </p>
      <p>
        That is not a catastrophic break, but it is a free ordering hint for
        anyone building a guess list, and it quietly shaves entropy off every
        secret you issue. The fix is rejection sampling and it costs nothing but
        a few discarded bytes — about 3% of draws for a 62-character alphabet,
        30% for the full 89-character one. Compute <code class={codeCls}
          >limit = Math.floor(256 / size) * size</code
        >, throw away any byte at or above <code class={codeCls}>limit</code>,
        and take the modulo of what survives. Every index then has exactly equal
        probability. That is what runs when you click Generate above. Hex and
        base64url skip the rejection entirely, because 16 and 64 both divide
        256.
      </p>

      <h2 class={h2Cls}>What 128 bits actually buys you</h2>
      <p>
        Entropy is <code class={codeCls}>length × log₂(alphabetSize)</code>, and
        the readout above shows the exact figure for whatever you have
        configured. 128 bits means 3.4 × 10³⁸ candidate values. Give an attacker
        a billion machines each testing a trillion candidates per second — 10²¹
        guesses a second, which nobody on earth has — and the expected time to
        land on yours is still around five billion years.
      </p>
      <p>
        So 128 bits ends the conversation. 32 hex characters is exactly 128
        bits. 22 alphanumeric characters is 131. A <a
          href="/tools/uuid-generator/"
          class={linkCls}>v4 UUID</a
        > carries 122 — close enough to the bar that people reach for one as an API
        key. Don't. UUIDs end up in URLs, access logs, and error messages precisely
        because they are built to be identifiers, not secrets. Going past 128 bits
        is not more secure either, it is a longer line in your <code
          class={codeCls}>.env</code
        >, and it does nothing about the way secrets are actually compromised,
        which is leaking rather than guessing. The symbol set here also
        deliberately omits quotes, backticks, backslashes and spaces: they buy
        well under a bit per character and cost you an afternoon the first time
        a secret containing a backtick passes through a shell script, a dotenv
        parser and a YAML file.
      </p>

      <h2 class={h2Cls}>Generating is the easy part</h2>
      <p>
        The value above is worth nothing the moment it lands somewhere durable
        and unencrypted. It belongs in a secret manager — Vault, AWS Secrets
        Manager, Doppler, 1Password, or <a
          href="/blog/coolify-self-hosted-saas/"
          class={linkCls}>your platform's encrypted environment store</a
        > if you self-host — injected at boot, never committed. If you have ever run
        <code class={codeCls}>git add -A</code> in a directory containing a real
        <code class={codeCls}>.env</code>, go check your history before you read
        further.
      </p>
      <p>
        Rotation is a design decision, not a chore. Your verifier has to accept
        the old value and the new one during an overlap window; if it cannot,
        "rotating" is a synonym for "brief outage", which is exactly why so many
        teams never rotate anything. Give every environment its own value — a
        staging key that also opens production is one leaked CI log away from
        being a production breach. Rotate on a schedule, on offboarding, and
        immediately on suspicion. "I think it's fine" is not an incident
        response.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-5 pb-10">
    <h2 class="display mb-6 text-2xl uppercase">Questions, answered.</h2>
    <div class="grid gap-4">
      {
        faq.map((f) => (
          <details class="group border-ink bg-paper shadow-neo-sm rounded-[4px] border-[3px]">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-4 font-bold">
              <span>{f.q}</span>
              <Icon
                name="lucide:plus"
                class="h-5 w-5 shrink-0 transition-transform group-open:rotate-45"
                aria-hidden="true"
              />
            </summary>
            <p class="px-4 pb-4 text-sm leading-relaxed opacity-90">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- RELATED -->
  <section class="mx-auto max-w-3xl px-5 pb-16">
    <h2 class="heading mb-5 text-xl uppercase">Keep reading</h2>
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        related.map((r) => (
          <li>
            <NeoCard
              href={r.href}
              tone="paper"
              shadow="sm"
              hover
              class="flex h-full flex-col gap-2"
            >
              <span class="mono inline-flex items-center gap-2 text-[10px] font-bold tracking-widest uppercase opacity-70">
                <Icon name={r.icon} class="h-3.5 w-3.5" aria-hidden="true" />
                {r.kind}
              </span>
              <span class="heading text-lg leading-tight uppercase">
                {r.title}
              </span>
              <span class="text-sm leading-snug opacity-90">{r.blurb}</span>
            </NeoCard>
          </li>
        ))
      }
    </ul>
    <p class="mono mt-6 text-[11px] tracking-widest uppercase opacity-60">
      ▸ Everything on this page runs client-side. No secret is transmitted,
      stored, or logged.
    </p>
  </section>

  <RelatedLinks items={relatedLinks} />
</Page>

<script>
  import "@/scripts/secret-generator";
</script>
