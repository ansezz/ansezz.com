---
import Page from "@/layouts/Page.astro";
import NeoCard from "@/components/neobrutalist/NeoCard.astro";
import { Icon } from "astro-icon/components";
import { TOOLS, TOOL_LIST, TOOL_GROUPS, SITE } from "@/consts";
import { breadcrumbList, collectionPage } from "@/lib/seo";

const breadcrumbLd = breadcrumbList([
  { name: "Home", url: SITE.URL },
  { name: "Tools", url: "/tools/" },
]);

const live = TOOL_LIST.filter((t) => t.status === "live");

const collectionLd = collectionPage({
  url: new URL("/tools/", SITE.URL).href,
  title: TOOLS.TITLE,
  description: TOOLS.DESCRIPTION,
  items: live.map((t) => ({
    url: t.href,
    name: t.title,
    description: t.blurb,
  })),
});

// Only render a section if it actually has tools in it.
const groups = TOOL_GROUPS.map((g) => ({
  ...g,
  tools: TOOL_LIST.filter((t) => t.group === g.id),
})).filter((g) => g.tools.length > 0);
---

<Page
  title={TOOLS.TITLE}
  description={TOOLS.DESCRIPTION}
  eyebrow="Free tools"
  heading="Tools I built because I needed them."
  intro={TOOLS.DESCRIPTION}
  structuredData={[breadcrumbLd, collectionLd]}
>
  <section class="mx-auto max-w-5xl px-5 pb-10">
    <NeoCard tone="yellow" shadow="md" class="flex flex-wrap gap-x-8 gap-y-3">
      <p class="mono text-[11px] font-bold tracking-widest uppercase">
        ▸ {live.length} tools · free · no signup
      </p>
      <p class="mono text-[11px] font-bold tracking-widest uppercase">
        ▸ 100% client-side
      </p>
      <p class="mono text-[11px] font-bold tracking-widest uppercase">
        ▸ Nothing uploaded, nothing logged
      </p>
    </NeoCard>
  </section>

  {
    groups.map((group) => (
      <section class="mx-auto max-w-5xl px-5 pb-14">
        <div class="border-ink mb-6 border-b-[3px] pb-4">
          <h2 class="display text-2xl leading-none uppercase md:text-3xl">
            {group.label}
          </h2>
          <p class="text-ink/80 mt-2 max-w-2xl text-sm leading-snug">
            {group.blurb}
          </p>
        </div>

        <ul class="grid gap-6 sm:grid-cols-2">
          {group.tools.map((t, i) => {
            const isLive = t.status === "live";
            const Wrapper = isLive ? "a" : "div";
            return (
              <li class="min-w-0">
                <Wrapper
                  href={isLive ? t.href : undefined}
                  data-neo-hover={isLive ? "" : undefined}
                  class:list={[
                    "block h-full",
                    isLive ? "" : "cursor-default opacity-60",
                  ]}
                >
                  <NeoCard
                    tone={t.tone}
                    shadow="md"
                    tilt={i % 2 === 0 ? -0.4 : 0.4}
                    class="flex h-full flex-col gap-3"
                  >
                    <div class="flex items-center justify-between">
                      <span
                        class="border-ink bg-paper text-ink shadow-neo-xs inline-flex h-11 w-11 items-center justify-center rounded-[6px] border-[2.5px]"
                        aria-hidden="true"
                      >
                        <Icon name={t.icon} class="h-5 w-5" />
                      </span>
                      <span class="mono border-ink bg-paper rounded-full border-[2px] px-2 py-0.5 text-[10px] font-bold tracking-widest uppercase">
                        {isLive ? "Live" : "Soon"}
                      </span>
                    </div>
                    <h3 class="heading text-xl leading-tight uppercase">
                      {t.title}
                    </h3>
                    <p class="text-sm leading-snug opacity-90">{t.blurb}</p>
                    {isLive && (
                      <p class="mono mt-auto inline-flex items-center gap-1 pt-2 text-xs font-bold tracking-widest uppercase">
                        Open
                        <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
                      </p>
                    )}
                  </NeoCard>
                </Wrapper>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</Page>
