---
import Page from "@/layouts/Page.astro";
import ToolMeta from "@/components/tools/ToolMeta.astro";
import RelatedLinks from "@/components/RelatedLinks.astro";
import NeoCard from "@/components/neobrutalist/NeoCard.astro";
import NeoButton from "@/components/neobrutalist/NeoButton.astro";
import StickyNote from "@/components/neobrutalist/StickyNote.astro";
import ComparisonTable from "@/components/neobrutalist/ComparisonTable.astro";
import { Icon } from "astro-icon/components";
import { SITE, getTool } from "@/consts";
import { breadcrumbList, faqPage, toolScreenshot } from "@/lib/seo";
import {
  LLM_MODELS,
  LLM_DATA_VERIFIED,
  PROVIDER_LABEL,
} from "@/data/llm-models";

const tool = getTool("/tools/llm-cost-calculator/");

const TOOL_NAME = "LLM Cost Calculator";
const TOOL_PATH = "/tools/llm-cost-calculator/";
const TOOL_DESCRIPTION =
  "LLM cost calculator for Claude, GPT and Gemini. Estimate API spend per request, day and month, with prompt cache read and write prices. Runs in your browser.";

const breadcrumbLd = breadcrumbList([
  { name: "Home", url: SITE.URL },
  { name: "Tools", url: "/tools/" },
  { name: TOOL_NAME, url: TOOL_PATH },
]);

// Prices come from the shared model file, src/data/llm-models.ts, which
// records where and when each number was checked.
const modelsJson = JSON.stringify(LLM_MODELS);
const verifiedText = new Date(
  `${LLM_DATA_VERIFIED}T00:00:00Z`,
).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const providers = (["anthropic", "openai", "google"] as const).map((p) => ({
  label: PROVIDER_LABEL[p],
  models: LLM_MODELS.filter((m) => m.provider === p),
}));
const inputCls =
  "border-ink bg-paper shadow-neo-sm min-h-11 w-full min-w-0 rounded-[4px] border-[3px] px-3 py-2.5 font-mono font-bold focus:outline-none";
const labelCls =
  "mono mb-2 block text-[11px] font-bold tracking-widest uppercase";

const batchColumns = [
  { label: "Realtime call", tone: "cyan" as const },
  { label: "Batch / async call", tone: "green" as const },
];

const batchRows = [
  {
    icon: "lucide:tag",
    label: "Price vs list",
    cells: ["1×", "~0.5× on input and output"],
  },
  {
    icon: "lucide:timer",
    label: "Turnaround",
    cells: ["Milliseconds to seconds", "Minutes, up to 24 hours"],
  },
  { icon: "lucide:radio", label: "Streaming", cells: [true, false] },
  {
    icon: "lucide:gauge",
    label: "Rate-limit pool",
    cells: ["Your standard quota", "Separate, far larger queue"],
  },
  {
    icon: "lucide:target",
    label: "Fits",
    cells: [
      "Chat, agents, anything a user waits on",
      "Backfills, evals, embeddings, nightly enrichment",
    ],
  },
];

const faq = [
  {
    q: "How do I calculate the cost of an LLM API call?",
    a: "Multiply input tokens by the input price per million, multiply output tokens by the output price per million, and add the two. Both meters are billed separately and at different rates, so you cannot use a single blended number. This calculator does that arithmetic per request, then scales it by requests per day and a 30-day month.",
  },
  {
    q: "Why are output tokens more expensive than input tokens?",
    a: "Because they are produced differently. Your whole prompt is processed in one parallel prefill pass, while output is generated one token at a time, and each token needs a full forward pass through the model. That decode loop is limited by memory bandwidth and cannot run in parallel within a request. In the model list above, output costs 5 times input on every Claude and GPT-6 model, 6 times on Gemini 3.1 Pro, and about 8 times on Gemini 3.5 Flash-Lite.",
  },
  {
    q: "How much does prompt caching actually save?",
    a: "It depends on your hit rate. On Claude, writing a prefix into the cache costs 1.25 times the base input price for the 5 minute cache, or 2 times for the 1 hour cache. A hit costs 0.1 times base, and less on Opus 5.5 and Fable 5.1. GPT-6 models list the same 1.25 times write price and a 0.05 to 0.1 times read price. Gemini charges no write premium but bills storage per hour for explicit caches. With a 5 minute cache, one reuse pays for the write. With low traffic, most requests miss and pay the premium, so caching can cost more than it saves. Set the hit rate above and the calculator shows both sides.",
  },
  {
    q: "Are the LLM prices in this calculator up to date?",
    a: "They are standard list rates, checked against each provider's public pricing page on the date shown at the top of the tool. They will drift. Providers change prices, add tiers, and charge more for long-context requests: GPT-6 and Gemini 3.1 Pro roughly double the rate above a context threshold. Gemini 3.8 Flash is on a launch price that doubles on January 1, 2027. Treat the dropdown as a starting point, and edit the price fields if your numbers differ. Nothing here knows about enterprise discounts or batch rates.",
  },
  {
    q: "Why is my AI agent so expensive compared to a single chat call?",
    a: "Because every turn re-sends the entire conversation, including the system prompt and all tool definitions, so input cost grows quadratically with turn count rather than linearly. A 20-turn run with a 3,000-token header and 1,200 tokens added per turn burns about 288,000 input tokens, not 60,000. Feed the average input across turns into the box above, not the opening prompt, and multiply requests per day by turns per task.",
  },
  {
    q: "Does this LLM cost calculator send my data anywhere?",
    a: "No. The whole thing is a few lines of arithmetic running in your browser. No request is made, no numbers are stored, and there is no signup. The share button only puts your inputs in the page address. Open the network tab and watch it stay empty, or load the page once and then go offline.",
  },
];

const appLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  dateModified: tool.updated,
  name: TOOL_NAME,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any (browser)",
  url: new URL(TOOL_PATH, SITE.URL).href,
  description: TOOL_DESCRIPTION,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  isAccessibleForFree: true,
  browserRequirements: "Requires JavaScript",
  author: { "@id": `${SITE.URL}#person` },
  inLanguage: "en",
  screenshot: toolScreenshot(new URL(TOOL_PATH, SITE.URL).href),
  featureList: [
    "Monthly API cost for Claude, GPT and Gemini models",
    "Prompt cache read and write prices with hit rate",
    "Batch API discount and long context pricing",
    "Shareable link with your inputs",
  ],
  creator: { "@id": `${SITE.URL}#person` },
};

const faqLd = faqPage(faq.map((f) => ({ question: f.q, answer: f.a })));

const relatedLinks = [
  {
    href: "/tools/token-counter/",
    note: "The cost model is only as good as the token count you feed it.",
  },
  {
    href: "/tools/context-window-checker/",
    note: "Long context is the line item people forget to model.",
  },
  {
    href: "/blog/rate-limiting-ai-wallet/",
    note: "Denial-of-wallet: how a metered AI endpoint becomes an unbounded bill.",
    kind: "Post" as const,
  },
  {
    href: "/blog/training-vs-inference/",
    note: "Where the money actually goes once you are serving rather than training.",
    kind: "Post" as const,
  },
];
---

<Page
  title={tool.seoTitle}
  dateModified={tool.updated}
  description={TOOL_DESCRIPTION}
  eyebrow="Free tool"
  heading="LLM Cost Calculator."
  intro="Plug in tokens, requests, and a model. See the daily and monthly API bill before you ship it to production."
  structuredData={[breadcrumbLd, appLd, faqLd]}
>
  <section class="mx-auto max-w-5xl px-5 pb-6">
    <StickyNote tone="yellow" tilt={-1.5} class="max-w-md">
      <p class="mono mb-1 text-[10px] font-bold tracking-widest uppercase">
        ▸ Prices checked {verifiedText}
      </p>
      <p class="text-sm leading-snug font-bold">
        List prices from each provider's pricing page, standard tier. Confirm
        before you commit a budget.
      </p>
    </StickyNote>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-16">
    <form
      id="cost-form"
      class="grid items-start gap-6 md:grid-cols-[minmax(0,1fr)_360px]"
      data-models={modelsJson}
    >
      <!-- Inputs -->
      <NeoCard tone="paper" shadow="md" class="min-w-0 space-y-5">
        <div>
          <label for="model" class={labelCls}>Model</label>
          <select
            id="model"
            class="border-ink bg-paper shadow-neo-sm min-h-11 w-full rounded-[4px] border-[3px] px-3 py-2.5 font-bold focus:outline-none"
          >
            {
              providers.map((p) => (
                <optgroup label={p.label}>
                  {p.models.map((m) => (
                    <option
                      value={m.id}
                      selected={m.id === "claude-sonnet-5-5"}
                    >
                      {m.label}
                    </option>
                  ))}
                </optgroup>
              ))
            }
            <option value="custom">Custom (enter prices)</option>
          </select>
        </div>

        <fieldset class="space-y-3">
          <legend class={labelCls}>Prices, $ per 1M tokens</legend>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="priceIn" class="mb-1 block text-xs font-bold"
                >Input</label
              >
              <input
                id="priceIn"
                type="number"
                min="0"
                step="0.001"
                value="2"
                class={inputCls}
              />
            </div>
            <div>
              <label for="priceOut" class="mb-1 block text-xs font-bold"
                >Output</label
              >
              <input
                id="priceOut"
                type="number"
                min="0"
                step="0.001"
                value="10"
                class={inputCls}
              />
            </div>
            <div>
              <label for="priceRead" class="mb-1 block text-xs font-bold"
                >Cache read (hit)</label
              >
              <input
                id="priceRead"
                type="number"
                min="0"
                step="0.001"
                value="0.2"
                class={inputCls}
              />
            </div>
            <div>
              <label for="priceWrite" class="mb-1 block text-xs font-bold"
                >Cache write</label
              >
              <input
                id="priceWrite"
                type="number"
                min="0"
                step="0.001"
                value="2.5"
                class={inputCls}
              />
            </div>
          </div>
        </fieldset>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="tokIn" class={labelCls}>Input tokens / request</label>
            <input
              id="tokIn"
              type="number"
              min="0"
              step="1"
              value="12000"
              class={inputCls}
            />
          </div>
          <div>
            <label for="tokOut" class={labelCls}>Output tokens / request</label>
            <input
              id="tokOut"
              type="number"
              min="0"
              step="1"
              value="600"
              class={inputCls}
            />
          </div>
          <div>
            <label for="tokCached" class={labelCls}>Cached prefix tokens</label>
            <input
              id="tokCached"
              type="number"
              min="0"
              step="1"
              value="8000"
              class={inputCls}
            />
          </div>
          <div>
            <label for="reqs" class={labelCls}>Requests / day</label>
            <input
              id="reqs"
              type="number"
              min="0"
              step="1"
              value="1000"
              class={inputCls}
            />
          </div>
        </div>
        <p class="-mt-2 text-xs leading-snug opacity-80">
          Cached prefix is the part of each input that repeats: system prompt,
          tool definitions, a shared document. Set it to 0 to ignore caching.
        </p>

        <fieldset class="border-ink space-y-3 border-t-[2.5px] pt-4">
          <legend class={labelCls}>Prompt cache</legend>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="hitRate" class="mb-1 block text-xs font-bold"
                >Hit rate, %</label
              >
              <input
                id="hitRate"
                type="number"
                min="0"
                max="100"
                step="1"
                value="90"
                class={inputCls}
              />
            </div>
            <div>
              <label for="cacheTtl" class="mb-1 block text-xs font-bold"
                >Cache lifetime</label
              >
              <select
                id="cacheTtl"
                class="border-ink bg-paper shadow-neo-sm min-h-11 w-full rounded-[4px] border-[3px] px-3 py-2.5 font-bold focus:outline-none disabled:opacity-60"
              >
                <option value="5m">5 minutes</option>
                <option value="1h">1 hour (Claude)</option>
              </select>
            </div>
            <div>
              <label for="storage" class="mb-1 block text-xs font-bold"
                >Storage $ / 1M / hour</label
              >
              <input
                id="storage"
                type="number"
                min="0"
                step="0.01"
                value="0"
                class={inputCls}
              />
            </div>
            <div>
              <label for="storageHours" class="mb-1 block text-xs font-bold"
                >Hours stored / day</label
              >
              <input
                id="storageHours"
                type="number"
                min="0"
                max="24"
                step="1"
                value="0"
                class={inputCls}
              />
            </div>
          </div>
          <p
            id="cache-hint"
            class="text-xs leading-snug font-bold"
            aria-live="polite"
          >
          </p>
          <p class="text-xs leading-snug opacity-80">
            Misses pay the write price for the prefix, hits pay the read price.
            Storage only applies to explicit Gemini caches. Leave hours at 0 for
            implicit caching.
          </p>
        </fieldset>
      </NeoCard>

      <!-- Output -->
      <NeoCard
        tone="cyan"
        shadow="lg"
        class="min-w-0 space-y-4 md:sticky md:top-24"
      >
        <p class="mono text-[11px] font-bold tracking-widest uppercase">
          ▸ Estimated spend
        </p>
        <dl class="space-y-3">
          <div
            class="border-ink flex items-end justify-between gap-2 border-b-[2.5px] pb-2"
          >
            <dt class="text-sm font-bold uppercase">Per request</dt>
            <dd id="out-req" class="display text-2xl leading-none">$0</dd>
          </div>
          <div
            class="border-ink flex items-end justify-between gap-2 border-b-[2.5px] pb-2"
          >
            <dt class="text-sm font-bold uppercase">Per day</dt>
            <dd id="out-day" class="display text-3xl leading-none">$0</dd>
          </div>
          <div class="flex items-end justify-between gap-2">
            <dt class="text-sm font-bold uppercase">Per month</dt>
            <dd
              id="out-month"
              class="display text-accent-text text-4xl leading-none"
            >
              $0
            </dd>
          </div>
        </dl>
        <div class="border-ink space-y-1 border-t-[2.5px] pt-3 text-sm">
          <p class="flex justify-between gap-2 font-bold">
            <span>Same month, no cache</span><span id="out-nocache">$0</span>
          </p>
          <p id="out-saved" class="text-xs font-bold opacity-90"></p>
        </div>
        <details class="text-sm">
          <summary class="flex min-h-10 cursor-pointer items-center font-bold">
            Monthly breakdown
          </summary>
          <dl class="mt-2 space-y-1">
            <div class="flex justify-between gap-2">
              <dt>Uncached input</dt><dd id="br-in">$0</dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt>Cache reads</dt><dd id="br-read">$0</dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt>Cache writes</dt><dd id="br-write">$0</dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt>Cache storage</dt><dd id="br-store">$0</dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt>Output</dt><dd id="br-out">$0</dd>
            </div>
          </dl>
        </details>
        <p class="mono pt-1 text-[10px] tracking-widest uppercase opacity-70">
          30-day month · live as you type
        </p>
        <button
          type="button"
          id="cost-share"
          class="border-ink bg-paper shadow-neo-sm min-h-11 w-full rounded-[4px] border-[3px] px-3 py-2 text-sm font-bold uppercase"
        >
          Copy link to this estimate
        </button>
        <p
          id="cost-share-status"
          class="text-center text-xs font-bold"
          aria-live="polite"
        >
        </p>
        <NeoButton href="/contact/" variant="ink" size="sm" fullWidth>
          Need this productionized? →
        </NeoButton>
      </NeoCard>
    </form>
  </section>

  <!-- EXPLAINER -->
  <section class="mx-auto max-w-3xl space-y-10 px-5 pb-16">
    <div class="space-y-4">
      <h2 class="display text-2xl uppercase">
        Input and output are two prices
      </h2>
      <p class="text-base leading-relaxed opacity-90">
        Every provider bills two meters, not one. Tokens you send are input,
        tokens the model generates are output, and output is always the
        expensive side. In the dropdown above, output costs 5 times input on
        every Claude and GPT-6 model and 6 times on Gemini 3.1 Pro.
      </p>
      <p class="text-base leading-relaxed opacity-90">
        That gap is hardware, not margin games. Your prompt is processed in one
        parallel prefill pass, while output emerges one token at a time, each
        needing a full forward pass — a sequential, memory-bandwidth-bound loop.
        So classification, extraction and routing are cheap per request, while
        drafting and code generation are not. At a 5× ratio, 200 extra output
        tokens cost exactly what 1,000 extra input tokens cost.
      </p>
    </div>

    <div class="space-y-4">
      <h2 class="display text-2xl uppercase">
        Prompt caching redraws the maths
      </h2>
      <p class="text-base leading-relaxed opacity-90">
        Caching is the biggest lever on this page. The shape is the same
        everywhere: the first request writes a prompt prefix into the cache, and
        later requests that reuse that exact prefix read it at a steep discount.
        What differs is the price of the write.
      </p>
      <ul class="space-y-2 text-base leading-relaxed opacity-90">
        <li class="flex gap-3">
          <span aria-hidden="true" class="font-bold">▸</span>
          <span
            ><strong>Claude.</strong> Mark a breakpoint with <code
              class="mono font-bold">cache_control</code
            >. A write costs 1.25 times base input for the 5 minute cache or 2
            times for the 1 hour cache. A hit costs 0.1 times base, 0.05 times
            on Opus 5.5 and 0.025 times on Fable 5.1. Each hit also resets the
            timer.</span
          >
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="font-bold">▸</span>
          <span
            ><strong>OpenAI.</strong> Caching is automatic on repeated prefixes. GPT-6
            models list a cache write at 1.25 times input and a cached read at 0.05
            to 0.1 times input.</span
          >
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="font-bold">▸</span>
          <span
            ><strong>Gemini.</strong> Implicit caching has no write premium. Explicit
            caches bill a read rate of 0.1 times input plus storage per 1M tokens
            per hour, so a cache you keep alive all day has a fixed cost.</span
          >
        </li>
      </ul>
      <p class="text-base leading-relaxed opacity-90">
        So the hit rate decides everything. Each miss pays the write price for
        the whole prefix, each hit pays the read price. On Claude with the 5
        minute cache, the premium is 0.25 times and each hit saves 0.9 times, so
        one reuse pays for the write. On a quiet endpoint where requests are
        farther apart than the cache lifetime, almost every request is a miss
        and caching costs more than it saves. The hint under the cache inputs
        tells you which side of that line your traffic sits on. Matching is on
        an exact prefix, so keep timestamps and changing retrieval blocks at the
        end of the prompt.
      </p>
    </div>

    <div class="space-y-4">
      <h2 class="display text-2xl uppercase">
        Your token counts are estimates
      </h2>
      <p class="text-base leading-relaxed opacity-90">
        This calculator does not tokenize anything. It multiplies the numbers
        you hand it. The <a
          href="/tools/token-counter/"
          class="font-bold underline decoration-2 underline-offset-2"
          >token counter</a
        > gives exact GPT counts and estimates for Claude and Gemini. If your numbers
        come from a characters divided by 4 rule of thumb instead, expect 10 to 15%
        error on English prose and worse elsewhere:
      </p>
      <ul class="space-y-2 text-base leading-relaxed opacity-90">
        <li class="flex gap-3">
          <span aria-hidden="true" class="font-bold">▸</span>
          <span
            ><strong>Code.</strong> Indentation, braces, punctuation and camelCase
            splits push you nearer 2.5–3 characters per token, so a prose-tuned estimate
            undercounts a diff.</span
          >
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="font-bold">▸</span>
          <span
            ><strong>Non-English text.</strong> Tokenizer vocabularies are English-dominated,
            so Cyrillic, Devanagari, Arabic and CJK routinely cost two to four times
            as many tokens.</span
          >
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="font-bold">▸</span>
          <span
            ><strong>High-entropy strings.</strong> UUIDs, hashes, base64 and minified
            JSON have no learned merges and fragment almost character by character.</span
          >
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="font-bold">▸</span>
          <span
            ><strong>Reasoning tokens.</strong> Billed as output whether or not the
            API hands the text back to you — the line item that surprises people on
            thinking models.</span
          >
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="font-bold">▸</span>
          <span
            ><strong>Images and audio.</strong> Converted to tokens by a per-tile
            or per-second formula, billed at the input rate.</span
          >
        </li>
      </ul>
      <p class="text-base leading-relaxed opacity-90">
        Providers also use different tokenizers, so the same string counts
        differently on Claude, GPT, and Gemini. When it matters, count with the
        provider's own.
      </p>
    </div>

    <div class="space-y-4">
      <h2 class="display text-2xl uppercase">
        Batch mode is 50% off, mostly unclaimed
      </h2>
      <p class="text-base leading-relaxed opacity-90">
        Anthropic, OpenAI, and Google all sell the same deal: submit work
        asynchronously and pay roughly half list on both meters, in exchange for
        a turnaround measured in minutes to 24 hours. Same models, half the
        invoice.
      </p>
      <ComparisonTable columns={batchColumns} rows={batchRows} />
      <p class="text-base leading-relaxed opacity-90">
        Anything a human is not waiting on belongs in the right-hand column:
        embedding backfills, evals, nightly enrichment, bulk classification. To
        model it, pick <strong>Custom</strong> and halve both prices.
      </p>
    </div>

    <div class="space-y-4">
      <h2 class="display text-2xl uppercase">
        The agent loop is where bills explode
      </h2>
      <p class="text-base leading-relaxed opacity-90">
        The single biggest surprise on a real invoice: an agent does not make N
        cheap calls — it re-sends the entire conversation every turn. Each tool
        result is appended, and the whole transcript, system prompt and tool
        definitions included, goes back over the wire next turn. Input cost
        grows quadratically with turn count.
      </p>
      <p class="text-base leading-relaxed opacity-90">
        Concretely: a 3,000-token system-and-tools header, 1,200 tokens added
        per turn, 20 turns. Turn one sends 3,000 input tokens; turn twenty sends
        25,800; the run totals 288,000 for an average of 14,400 per call.
        Estimating it as "20 calls at the opening prompt size" understates the
        bill by nearly 5×.
      </p>
      <p class="text-base leading-relaxed opacity-90">
        So the <strong>input tokens / request</strong> field above wants the average
        across turns, and requests per day means tasks per day times turns per task.
        Caching also stops being optional here: an agent conversation grows purely
        by appending, the ideal cache shape. And it is why capping an agent by request
        count, not tokens, protects nothing.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-5 pb-16">
    <h2 class="display mb-6 text-2xl uppercase">Questions, answered</h2>
    <div class="space-y-4">
