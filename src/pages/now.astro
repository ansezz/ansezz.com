---
import Page from "@/layouts/Page.astro";
import RelatedLinks, {
  type RelatedLink,
} from "@/components/RelatedLinks.astro";
import NeoCard from "@/components/neobrutalist/NeoCard.astro";
import NeoButton from "@/components/neobrutalist/NeoButton.astro";
import StickyNote from "@/components/neobrutalist/StickyNote.astro";
import { Icon } from "astro-icon/components";
import { NOW, OWNER, SITE } from "@/consts";
import { breadcrumbList } from "@/lib/seo";

const breadcrumbLd = breadcrumbList([
  { name: "Home", url: SITE.URL },
  { name: "Now", url: "/now/" },
]);

const updated = new Date(NOW.UPDATED).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const relatedLinks: RelatedLink[] = [
  {
    href: "/blog/series/rag-in-production/",
    kind: "Series",
    note: "Everything that breaks when RAG meets real users, and how to fix it.",
  },
  {
    href: "/blog/series/shopify-plus/",
    kind: "Series",
    note: "Agentic commerce, UCP, headless \u2014 the Shopify Plus work in depth.",
  },
  {
    href: "/work/",
    kind: "Page",
    note: "What's already shipped, filterable by lane.",
  },
  {
    href: "/services/",
    kind: "Page",
    note: "How an engagement runs if you want to work together on any of it.",
  },
];
---

<Page
  title={NOW.TITLE}
  description={NOW.DESCRIPTION}
  eyebrow="Now"
  heading="What I'm doing now."
  intro="A snapshot of what has my attention this season — borrowed from Derek Sivers' /now page idea."
  structuredData={breadcrumbLd}
>
  <section class="mx-auto max-w-5xl px-5 pb-6">
    <StickyNote tone="yellow" tilt={-1.5} class="max-w-md">
      <p class="mono mb-1 text-[10px] font-bold tracking-widest uppercase">
        ▸ Last updated
      </p>
      <p class="text-sm leading-snug font-bold">
        {updated} — from {SITE.LOCATION} ({SITE.TZ}).
      </p>
    </StickyNote>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-12">
    <ul class="grid gap-6 md:grid-cols-2">
      {
        NOW.FOCUS.map((f, i) => (
          <li>
            <NeoCard
              tone={f.tone}
              shadow="md"
              tilt={i % 2 === 0 ? -0.3 : 0.3}
              class="flex h-full flex-col gap-3"
            >
              <span
                class="border-ink bg-paper text-ink shadow-neo-xs inline-flex h-11 w-11 items-center justify-center rounded-[6px] border-[2.5px]"
                aria-hidden="true"
              >
                <Icon name={f.icon} class="h-5 w-5" />
              </span>
              <h2 class="heading text-xl leading-tight uppercase">{f.title}</h2>
              <p class="text-sm leading-snug opacity-90 md:text-base">
                {f.body}
              </p>
            </NeoCard>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-16">
    <NeoCard tone="paper" class="space-y-4 text-center">
      <p
        class="mono text-pink-deep text-xs font-bold tracking-widest uppercase"
      >
        ▸ Want the long version?
      </p>
      <p class="mx-auto max-w-2xl text-base leading-snug md:text-lg">
        {OWNER.CURRENTLY}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <NeoButton href="/work/" variant="primary" size="lg">
          See the work →
        </NeoButton>
        <NeoButton href="/contact/" variant="ink" size="lg">
          <Icon name="lucide:mail" class="h-4 w-4" />
          Get in touch
        </NeoButton>
      </div>
    </NeoCard>
  </section>

  <RelatedLinks title="Dig into any of it" items={relatedLinks} />
</Page>
