---
import { getCollection } from "astro:content";
import Page from "@/layouts/Page.astro";
import PostCard from "@/components/blog/PostCard.astro";
import PostMeta from "@/components/blog/PostMeta.astro";
import TagPill from "@/components/neobrutalist/TagPill.astro";
import TagPillRow from "@/components/neobrutalist/TagPillRow.astro";
import HalftoneSection from "@/components/neobrutalist/HalftoneSection.astro";
import NeoButton from "@/components/neobrutalist/NeoButton.astro";
import NeoCard from "@/components/neobrutalist/NeoCard.astro";
import BurstBadge from "@/components/neobrutalist/BurstBadge.astro";
import StickyNote from "@/components/neobrutalist/StickyNote.astro";
import Search from "@/components/blog/Search.astro";
import { Icon } from "astro-icon/components";
import { getReadingTime } from "@/lib/reading";
import {
  BLOG,
  BLOG_CATEGORIES,
  CATEGORY_LABEL,
  CATEGORY_TONE,
  START_HERE,
  SITE,
  TAG_OG_MIN_POSTS,
} from "@/consts";
import { collectionPage, breadcrumbList } from "@/lib/seo";
import { tagSlug } from "@/lib/links";

const all = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const byId = new Map(all.map((p) => [p.id, p]));
const startHere = START_HERE.map((id) => byId.get(id)).filter(
  (p): p is (typeof all)[number] => Boolean(p),
);

const [featured, ...rest] = all;
const featuredRt = featured ? getReadingTime(featured.body) : "";
const featuredHero = featured?.data.heroImage;

const PAGE_SIZE = 9;
const visible = rest.slice(0, PAGE_SIZE);
const hasMore = rest.length > PAGE_SIZE;

const totalPosts = all.length;
// `all` is sorted featured-first, so all[0] is whatever is pinned — not the
// newest post. Take the real max across publish/update dates instead.
const latestDate = all.reduce<Date | undefined>((newest, p) => {
  const d = p.data.updatedDate ?? p.data.publishDate;
  return !newest || d > newest ? d : newest;
}, undefined);
const latestDateStr = latestDate
  ? latestDate.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "";

const categoryIcons: Record<string, string> = {
  laravel: "lucide:server",
  ai: "lucide:brain-circuit",
  shopify: "lucide:shopping-bag",
  devops: "lucide:cloud",
  architecture: "lucide:layers",
  career: "lucide:user",
};

const categoryCounts = Object.fromEntries(
  BLOG_CATEGORIES.map((c) => [
    c,
    all.filter((p) => p.data.category === c).length,
  ]),
) as Record<(typeof BLOG_CATEGORIES)[number], number>;

// Most-used tags, not "whichever 12 happened to be seen first" — and only
// tags with enough posts to be worth a click (thin tag pages are
// noindex,follow, so don't make them the featured entry points either).
const tagCounts = new Map<string, number>();
all.forEach((p) =>
  p.data.tags.forEach((t) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1)),
);
const topTags = [...tagCounts.entries()]
  .filter(([, n]) => n >= TAG_OG_MIN_POSTS)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 12);

const blogUrl = new URL("/blog/", SITE.URL).href;
const blogCollectionLd = collectionPage({
  url: blogUrl,
  title: BLOG.TITLE,
  description: BLOG.DESCRIPTION,
  itemType: "BlogPosting",
  items: all.slice(0, 20).map((p) => ({
    url: new URL(`/blog/${p.id}/`, SITE.URL).href,
    name: p.data.title,
    description: p.data.description,
    datePublished: p.data.publishDate.toISOString(),
  })),
});
const blogBreadcrumbLd = breadcrumbList([
  { name: "Home", url: SITE.URL },
  { name: "Blog", url: "/blog/" },
]);
---

<Page
  title={BLOG.TITLE}
  description={BLOG.DESCRIPTION}
  eyebrow="Blog"
  heading="Notes from the trenches."
  intro="Laravel internals, AI engineering with Claude + MCP, RAG pipelines, Shopify Plus, DevOps. Production lessons from shipped work — every post earns its slot. Featured = hand-picked or most recent."
  structuredData={[blogCollectionLd, blogBreadcrumbLd]}
  next={hasMore ? "/blog/page/2/" : undefined}
>
  <section class="mx-auto max-w-6xl px-5 pb-6">
    <div class="flex flex-wrap items-center gap-4">
      <StickyNote tone="yellow" tilt={-2} class="max-w-[300px]">
        <p class="mono mb-1 text-[10px] font-bold tracking-widest uppercase">
          ▸ {totalPosts} posts · last updated
        </p>
        <p class="text-sm leading-snug font-bold">{latestDateStr}</p>
      </StickyNote>
      <a
        href="/rss.xml"
        class="border-ink bg-paper shadow-neo-xs hover:shadow-neo-sm hover:bg-yellow inline-flex items-center gap-2 rounded-full border-[2.5px] px-3.5 py-1.5 text-xs font-bold tracking-wide uppercase transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
      >
        <Icon name="lucide:rss" class="h-3.5 w-3.5" />
        RSS feed
      </a>
    </div>
  </section>

  {
    startHere.length > 0 && (
      <section class="mx-auto max-w-6xl px-5 pb-8">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-4">
          <p class="mono text-accent-text text-xs font-bold tracking-widest uppercase">
            ▸ New here? Start with these
          </p>
          <a
            href="/blog/series/"
            class="mono border-ink bg-paper shadow-neo-xs hover:bg-yellow hover:shadow-neo-sm inline-flex items-center gap-1.5 rounded-full border-[2px] px-3 py-1 text-[11px] font-bold tracking-widest uppercase transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
          >
            <Icon name="lucide:layers" class="h-3.5 w-3.5" />
            Browse series
          </a>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {startHere.map((post, i) => (
            <li class="min-w-0">
              <a
                href={`/blog/${post.id}/`}
                data-neo-hover
                class="group border-ink bg-paper shadow-neo-sm hover:shadow-neo-md hover:bg-yellow flex h-full flex-col gap-2 rounded-[4px] border-[3px] p-4 transition-all hover:-translate-x-1 hover:-translate-y-1"
              >
                <span class="display text-2xl leading-none opacity-40">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="heading text-sm leading-tight uppercase">
                  {post.data.title}
                </span>
                <span class="mono mt-auto text-[10px] font-bold tracking-widest uppercase opacity-60">
                  {CATEGORY_LABEL[post.data.category]}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <Search />

  <HalftoneSection tone="bg" class="pb-2">
    <div class="mx-auto max-w-6xl px-5">
      <TagPillRow scrollOnMobile sticky class="!top-[60px] md:!top-[64px]">
        <li class="min-w-0">
          <TagPill tone="ink" href="/blog/" active>All · {totalPosts}</TagPill>
        </li>
        {
          BLOG_CATEGORIES.map((c) => (
            <li class="min-w-0">
              <TagPill tone={CATEGORY_TONE[c]} href={`/blog/category/${c}/`}>
                {CATEGORY_LABEL[c]} · {categoryCounts[c]}
              </TagPill>
            </li>
          ))
        }
      </TagPillRow>
    </div>
  </HalftoneSection>

  <div class="mx-auto max-w-6xl space-y-14 px-5 pt-10 pb-16">
    <section>
      <div class="mb-6">
        <BurstBadge tone="cyan" size="sm" class="mb-4">01</BurstBadge>
        <h2 class="display text-2xl leading-tight md:text-3xl">
          Browse by topic.
        </h2>
        <p
          class="mono mt-2 text-[11px] font-bold tracking-widest uppercase opacity-60"
        >
          ▸ Pick a lane · click a card to filter
        </p>
      </div>
      <ul class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-6">
        {
          BLOG_CATEGORIES.map((c, i) => (
            <li class="min-w-0">
              <NeoCard
                href={`/blog/category/${c}/`}
                tone={CATEGORY_TONE[c]}
                shadow="sm"
                hover
                tilt={i % 2 === 0 ? -0.4 : 0.4}
                class="flex flex-col items-center gap-2 !p-4 text-center"
              >
                <span
                  class="border-ink bg-paper text-ink shadow-neo-xs inline-flex h-10 w-10 items-center justify-center rounded-full border-[2.5px]"
                  aria-hidden="true"
                >
                  <Icon
                    name={categoryIcons[c] ?? "lucide:tag"}
                    class="h-5 w-5"
                  />
                </span>
                <p class="heading text-sm uppercase">{CATEGORY_LABEL[c]}</p>
                <p class="mono text-[10px] font-bold tracking-widest uppercase opacity-90">
                  {categoryCounts[c]}{" "}
                  {categoryCounts[c] === 1 ? "post" : "posts"}
                </p>
              </NeoCard>
            </li>
          ))
        }
      </ul>
    </section>

    {
      featured ? (
        <section>
          <div class="mb-6">
            <BurstBadge tone="pink" size="sm" class="mb-4">
              02
            </BurstBadge>
            <h2 class="display text-2xl leading-tight md:text-3xl">
              Latest drop.
            </h2>
            <p class="mono mt-2 text-[11px] font-bold tracking-widest uppercase opacity-60">
              ▸ Most recent · or pinned by hand
            </p>
          </div>
          <a
            href={`/blog/${featured.id}/`}
            data-neo-hover
            class="group border-ink shadow-neo-lg bg-yellow hover:shadow-neo-xl block overflow-hidden rounded-[4px] border-[3px] transition-all duration-150 hover:-translate-x-1 hover:-translate-y-1"
          >
            <div class="grid items-stretch md:grid-cols-[1.1fr_1fr]">
              {featuredHero && (
                <div class="border-ink bg-ink relative aspect-[2/1] min-h-[280px] overflow-hidden border-b-[3px] md:aspect-auto md:h-full md:border-r-[3px] md:border-b-0">
                  <img
                    src={featuredHero.url}
                    alt={featuredHero.alt}
                    width="1200"
                    height="800"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
              )}
              <div class="flex flex-col gap-4 p-6 md:p-10">
                <div class="flex flex-wrap items-center gap-3">
                  <BurstBadge tone="pink" size="sm">
                    NEW
                  </BurstBadge>
                  <span class="mono text-xs font-bold tracking-widest uppercase">
                    ▸ Featured post
                  </span>
                </div>
                <h3 class="display text-3xl leading-tight md:text-5xl">
                  {featured.data.title}
                </h3>
                <p class="text-base leading-snug md:text-lg">
                  {featured.data.description}
                </p>
                <PostMeta
                  date={featured.data.publishDate}
                  updatedDate={featured.data.updatedDate}
                  category={featured.data.category}
                  readingTime={featuredRt}
                  linkCategory={false}
                />
                <p class="mt-2 font-bold underline decoration-[3px] underline-offset-4">
                  Read post →
                </p>
              </div>
            </div>
          </a>
        </section>
      ) : (
        <div class="border-ink rounded-[4px] border-[3px] border-dashed p-12 text-center">
          <p class="display mb-2 text-3xl">No posts yet</p>
          <p class="opacity-70">First post lands soon.</p>
        </div>
      )
    }

    {
      visible.length > 0 && (
        <section>
          <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
            <div>
              <BurstBadge tone="yellow" size="sm" class="mb-4">
                03
              </BurstBadge>
              <h2 class="display text-2xl leading-tight md:text-3xl">
                More posts.
              </h2>
              <p class="mono mt-2 text-[11px] font-bold tracking-widest uppercase opacity-60">
                ▸ {visible.length} of {rest.length} · paginated below
              </p>
            </div>
            <NeoButton href="/rss.xml" variant="secondary" size="md">
              <Icon name="lucide:rss" class="h-4 w-4" />
              RSS
            </NeoButton>
          </div>
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {visible.map((post, i) => (
              <li class="min-w-0">
                <PostCard post={post} eager={i < 6} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      topTags.length > 0 && (
        <section>
          <div class="mb-5">
            <BurstBadge tone="purple" size="sm" class="mb-4">
              04
            </BurstBadge>
            <h2 class="display text-2xl leading-tight md:text-3xl">Tags.</h2>
            <p class="mono mt-2 text-[11px] font-bold tracking-widest uppercase opacity-60">
              ▸ Search by specific tech
            </p>
          </div>
          <ul class="flex flex-wrap gap-2">
            {topTags.map(([t, count], i) => {
              const tones = [
                "yellow",
                "pink",
                "cyan",
                "green",
                "red",
                "blue",
                "purple",
                "paper",
              ] as const;
              return (
                <li class="min-w-0">
                  <TagPill
                    tone={tones[i % tones.length]}
                    size="sm"
                    href={`/blog/tag/${tagSlug(t)}/`}
                  >
                    #{t} · {count}
                  </TagPill>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    {
      hasMore && (
        <nav
          class="border-ink flex flex-wrap items-center justify-between gap-4 border-t-[3px] pt-8"
          aria-label="Blog pagination"
        >
          <NeoButton variant="secondary" size="md" disabled>
            ← Newer
          </NeoButton>
          <p class="mono text-xs font-bold tracking-widest uppercase opacity-70">
            Page 1 · {Math.ceil(rest.length / PAGE_SIZE)} total
          </p>
          <NeoButton href="/blog/page/2/" variant="primary" size="md">
            Older →
          </NeoButton>
        </nav>
      )
    }
  </div>
</Page>
