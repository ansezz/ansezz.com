---
import { getCollection } from "astro:content";
import Page from "@/layouts/Page.astro";
import NeoCard from "@/components/neobrutalist/NeoCard.astro";
import { Icon } from "astro-icon/components";
import { BLOG_SERIES, SITE } from "@/consts";
import { breadcrumbList } from "@/lib/seo";

const all = await getCollection("blog", ({ data }) => !data.draft);
const titleOf = new Map(all.map((p) => [p.id, p.data.title]));

const breadcrumbLd = breadcrumbList([
  { name: "Home", url: SITE.URL },
  { name: "Blog", url: "/blog/" },
  { name: "Series", url: "/blog/series/" },
]);

const seriesListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Blog series",
  description:
    "Multi-part reading paths through the blog, each ordered from part one.",
  numberOfItems: BLOG_SERIES.length,
  itemListElement: BLOG_SERIES.map((s, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/blog/series/${s.slug}/`, SITE.URL).href,
    name: s.title,
    description: s.description,
  })),
};
---

<Page
  title="Series"
  description="Multi-part reading paths through the blog — vibe coding to agentic engineering, RAG in production, infrastructure decisions, Shopify Plus, and more, in order."
  eyebrow="Blog"
  heading="Read it as a series."
  intro="Related posts, ordered into a path. Start at part one and work through — or jump to whatever you need."
  structuredData={[breadcrumbLd, seriesListLd]}
>
  <section class="mx-auto max-w-5xl px-5 pb-16">
    <ul class="grid gap-6 md:grid-cols-2">
      {
        BLOG_SERIES.map((s, i) => (
          <li class="min-w-0">
            <a
              href={`/blog/series/${s.slug}/`}
              class="block h-full min-w-0"
              data-neo-hover
            >
              <NeoCard
                tone={s.tone}
                shadow="md"
                tilt={i % 2 === 0 ? -0.3 : 0.3}
                class="flex h-full flex-col gap-3"
              >
                <div class="flex items-center justify-between">
                  <span
                    class="border-ink bg-paper text-ink shadow-neo-xs inline-flex h-11 w-11 items-center justify-center rounded-[6px] border-[2.5px]"
                    aria-hidden="true"
                  >
                    <Icon name="lucide:layers" class="h-5 w-5" />
                  </span>
                  <span class="mono border-ink bg-paper rounded-full border-[2px] px-2 py-0.5 text-[10px] font-bold tracking-widest uppercase">
                    {s.posts.length} parts
                  </span>
                </div>
                <h2 class="heading text-xl leading-tight uppercase md:text-2xl">
                  {s.title}
                </h2>
                <p class="text-sm leading-snug opacity-90">{s.description}</p>
                <ol class="mt-auto space-y-1 pt-2 text-sm font-medium">
                  {s.posts.slice(0, 3).map((id, n) => (
                    <li class="flex min-w-0 gap-2">
                      <span class="mono shrink-0 text-[11px] opacity-60">
                        {String(n + 1).padStart(2, "0")}
                      </span>
                      <span class="min-w-0 flex-1 truncate">
                        {titleOf.get(id) ?? id}
                      </span>
                    </li>
                  ))}
                  {s.posts.length > 3 && (
                    <li class="mono text-[11px] opacity-60">
                      + {s.posts.length - 3} more →
                    </li>
                  )}
                </ol>
              </NeoCard>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Page>
