---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import RelatedPosts from "@/components/blog/RelatedPosts.astro";
import AuthorFooter from "@/components/blog/AuthorFooter.astro";
import TableOfContents from "@/components/blog/TableOfContents.astro";
import ShareBar from "@/components/blog/ShareBar.astro";
import ReadingProgress from "@/components/blog/ReadingProgress.astro";
import Comments from "@/components/blog/Comments.astro";
import SeriesNav from "@/components/blog/SeriesNav.astro";
import TagPill from "@/components/neobrutalist/TagPill.astro";
import ChecklistBox from "@/components/neobrutalist/ChecklistBox.astro";
import HalftoneSection from "@/components/neobrutalist/HalftoneSection.astro";
import PanelDivider from "@/components/neobrutalist/PanelDivider.astro";
import NeoButton from "@/components/neobrutalist/NeoButton.astro";
import NeoCard from "@/components/neobrutalist/NeoCard.astro";
import { Icon } from "astro-icon/components";
import { getReadingTime, getWordCount } from "@/lib/reading";
import { tagSlug } from "@/lib/links";
import { OWNER, SITE, CATEGORY_LABEL, CATEGORY_TONE } from "@/consts";
import { webPage } from "@/lib/seo";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const rt = getReadingTime(post.body, post);
const words = getWordCount(post.body, post);

const all = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
const currentIndex = all.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? all[currentIndex - 1] : undefined;
const nextPost =
  currentIndex >= 0 && currentIndex < all.length - 1
    ? all[currentIndex + 1]
    : undefined;
const related = all
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 3);

const skillsChecklist = post.data.tags.slice(0, 6).map((t) => ({
  label: t,
  done: true,
}));

const canonicalUrl = new URL(`/blog/${post.id}/`, SITE.URL).href;
// Real hero photo wins for social cards; otherwise use the per-post
// generated OG card (branded title card) instead of the generic og.webp.
const ogImagePath = post.data.heroImage?.url ?? `/og/blog/${post.id}.png`;
const heroUrl = new URL(ogImagePath, SITE.URL).href;

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

const webPageLd = {
  ...webPage({
    url: canonicalUrl,
    title: post.data.title,
    description: post.data.description,
    image: heroUrl,
  }),
  breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` },
};

const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${canonicalUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  url: canonicalUrl,
  mainEntityOfPage: { "@id": `${canonicalUrl}#webpage` },
  image: [heroUrl],
  wordCount: words,
  timeRequired: `PT${Math.max(1, Math.round(words / 200))}M`,
  author: {
    "@type": "Person",
    "@id": `${SITE.URL}#person`,
    name: OWNER.NAME,
    url: SITE.URL,
  },
  publisher: {
    "@type": "Person",
    "@id": `${SITE.URL}#person`,
    name: OWNER.NAME,
    url: SITE.URL,
  },
  articleSection: CATEGORY_LABEL[post.data.category],
  keywords: post.data.tags.join(", "),
  inLanguage: "en",
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: ["h1", "article.prose h2", "article.prose h3"],
  },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${canonicalUrl}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.URL },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: new URL("/blog/", SITE.URL).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: post.data.title,
      item: canonicalUrl,
    },
  ],
};

const relatedLd =
  related.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: "Related posts",
        itemListElement: related.map((p, i) => ({
          "@type": "ListItem",
          position: i + 1,
          url: new URL(`/blog/${p.id}/`, SITE.URL).href,
          name: p.data.title,
        })),
      }
    : null;

const structured = relatedLd
  ? [webPageLd, articleLd, breadcrumbLd, relatedLd]
  : [webPageLd, articleLd, breadcrumbLd];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={ogImagePath}
  ogType="article"
  article={{
    publishedTime: post.data.publishDate.toISOString(),
    modifiedTime: (
      post.data.updatedDate ?? post.data.publishDate
    ).toISOString(),
    author: OWNER.NAME,
    section: CATEGORY_LABEL[post.data.category],
    tags: post.data.tags,
  }}
  structuredData={structured}
>
  <ReadingProgress />

  <section class="mx-auto max-w-6xl px-5 pt-8 pb-6 md:pt-12 md:pb-8">
    <NeoButton href="/blog/" variant="secondary" size="sm" class="mb-6">
      ← Back to blog
    </NeoButton>

    <div class="mb-5 flex flex-wrap items-center gap-3">
      <TagPill
        tone={CATEGORY_TONE[post.data.category]}
        href={`/blog/category/${post.data.category}/`}
      >
        {CATEGORY_LABEL[post.data.category]}
      </TagPill>
      <span
        class="mono inline-flex items-center gap-1.5 text-xs font-bold tracking-widest uppercase opacity-70"
      >
        <Icon name="lucide:calendar" class="h-3.5 w-3.5" />
        {fmtDate(post.data.publishDate)}
      </span>
      {
        post.data.updatedDate && (
          <span class="mono inline-flex items-center gap-1.5 text-xs opacity-60">
            <Icon name="lucide:refresh-cw" class="h-3.5 w-3.5" />
            Updated {fmtDate(post.data.updatedDate)}
          </span>
        )
      }
      <span
        class="mono inline-flex items-center gap-1.5 text-xs font-bold tracking-widest uppercase opacity-70"
      >
        <Icon name="lucide:clock" class="h-3.5 w-3.5" />
        {rt}
      </span>
      <span
        class="mono inline-flex items-center gap-1.5 text-xs font-bold tracking-widest uppercase opacity-70"
      >
        <Icon name="lucide:type" class="h-3.5 w-3.5" />
        {words.toLocaleString()} words
      </span>
    </div>

    <h1
      class="display max-w-4xl text-[clamp(2.25rem,5.5vw,4.25rem)] leading-[0.95] tracking-tight"
    >
      {post.data.title}
    </h1>
    <p
      class="text-ink-soft mt-5 max-w-3xl text-base leading-snug sm:text-lg md:text-xl"
    >
      {post.data.description}
    </p>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
      <div class="inline-flex items-center gap-3">
        <span
          class="border-ink bg-yellow text-on-accent shadow-neo-xs inline-flex h-10 w-10 items-center justify-center rounded-full border-[2.5px]"
          aria-hidden="true"
        >
          <Icon name="lucide:user" class="h-5 w-5" />
        </span>
        <div class="leading-tight">
          <p class="text-sm font-bold">{OWNER.NAME}</p>
          <p
            class="mono text-[10px] font-bold tracking-widest uppercase opacity-70"
          >
            Backend · Architect · AI
          </p>
        </div>
      </div>
      <ShareBar title={post.data.title} url={canonicalUrl} label="Share" />
    </div>

    {
      post.data.tags.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2">
          {post.data.tags.map((t) => (
            <li>
              <TagPill tone="paper" size="sm" href={`/blog/tag/${tagSlug(t)}/`}>
                #{t}
              </TagPill>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {
    post.data.heroImage && (
      <section class="mx-auto max-w-6xl px-5 pb-10">
        <figure class="border-ink shadow-neo-md bg-ink mx-auto aspect-[16/10] max-w-5xl overflow-hidden rounded-[4px] border-[3px]">
          <img
            src={post.data.heroImage.url}
            alt={post.data.heroImage.alt}
            width="1600"
            height="1000"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        </figure>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-5 pb-10">
    <div class="grid gap-10 lg:grid-cols-[1fr_280px] lg:gap-12">
      <div class="min-w-0">
        {
          /* The sidebar is lg-only, so mobile/tablet readers would otherwise
            never see which series a post belongs to. */
        }
        <SeriesNav
          currentId={post.id}
          class="mb-8 max-w-3xl lg:hidden"
          data-pagefind-ignore
        />
        <article
          class="prose max-w-3xl min-w-0"
          data-pagefind-body
          data-pagefind-meta={`title:${post.data.title}`}
        >
          <Content />
        </article>
      </div>
      <aside class="hidden lg:block" data-pagefind-ignore>
        <div class="sticky top-24 space-y-5">
          <SeriesNav currentId={post.id} />
          <TableOfContents headings={headings} />
          {
            skillsChecklist.length > 0 && (
              <ChecklistBox
                title="Related skills"
                items={skillsChecklist}
                tone="cyan"
              />
            )
          }
          <NeoCard tone="paper" shadow="sm" class="space-y-3 !p-4">
            <p
              class="mono text-accent-text text-[10px] font-bold tracking-widest uppercase"
            >
              ▸ Liked this?
            </p>
            <p class="text-sm leading-snug font-bold">
              Grab the feed — new posts land in your reader.
            </p>
            <NeoButton href="/rss.xml" variant="primary" size="sm" fullWidth>
              <Icon name="lucide:rss" class="h-3.5 w-3.5" />
              RSS feed
            </NeoButton>
          </NeoCard>
        </div>
      </aside>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-10">
    <div
      class="border-ink mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 border-y-[3px] py-6"
    >
      <p
        class="mono text-accent-text text-xs font-bold tracking-widest uppercase"
      >
        ▸ Made it to the end? Send it around.
      </p>
      <ShareBar title={post.data.title} url={canonicalUrl} label="Share" />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-10">
    <PanelDivider shape="bolt" tone="pink" />
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-12">
    <AuthorFooter class="mx-auto max-w-4xl" />
  </section>

  <Comments />

  {
    (prevPost || nextPost) && (
      <section class="mx-auto max-w-6xl px-5 pb-16">
        <div class="mx-auto max-w-4xl">
          <p class="mono mb-4 text-center text-xs font-bold tracking-widest uppercase opacity-60">
            ▸ Keep reading
          </p>
          <nav class="grid gap-4 md:grid-cols-2" aria-label="Post navigation">
            {prevPost ? (
              <a
                href={`/blog/${prevPost.id}/`}
                data-neo-hover
                class="group border-ink bg-paper shadow-neo-sm hover:shadow-neo-md hover:bg-yellow flex items-start gap-3 rounded-[4px] border-[3px] p-5 transition-all hover:-translate-x-1 hover:-translate-y-1"
              >
                <Icon
                  name="lucide:arrow-left"
                  class="mt-0.5 h-5 w-5 shrink-0"
                />
                <div class="min-w-0 flex-1">
                  <p class="mono text-[10px] font-bold tracking-widest uppercase opacity-70">
                    Newer post
                  </p>
                  <p class="heading mt-1 text-base leading-tight uppercase md:text-lg">
                    {prevPost.data.title}
                  </p>
                </div>
              </a>
            ) : (
              <span />
            )}
            {nextPost ? (
              <a
                href={`/blog/${nextPost.id}/`}
                data-neo-hover
                class="group border-ink bg-paper shadow-neo-sm hover:shadow-neo-md hover:bg-yellow flex items-start gap-3 rounded-[4px] border-[3px] p-5 transition-all hover:-translate-x-1 hover:-translate-y-1 md:flex-row-reverse md:text-right"
              >
                <Icon
                  name="lucide:arrow-right"
                  class="mt-0.5 h-5 w-5 shrink-0"
                />
                <div class="min-w-0 flex-1">
                  <p class="mono text-[10px] font-bold tracking-widest uppercase opacity-70">
                    Older post
                  </p>
                  <p class="heading mt-1 text-base leading-tight uppercase md:text-lg">
                    {nextPost.data.title}
                  </p>
                </div>
              </a>
            ) : (
              <span />
            )}
          </nav>
        </div>
      </section>
    )
  }

  <HalftoneSection tone="bg" class="pb-16">
    <RelatedPosts posts={related} />
  </HalftoneSection>
</BaseLayout>
