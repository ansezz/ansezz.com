---
import { getCollection } from "astro:content";
import Page from "@/layouts/Page.astro";
import PostCard from "@/components/blog/PostCard.astro";
import { SITE, CARD_TONES, TAG_OG_MIN_POSTS, BLOG_TAGS } from "@/consts";
import type { BlogTag } from "@/consts";
import { breadcrumbList, collectionPage } from "@/lib/seo";
import { tagSlug } from "@/lib/links";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const tagMap = new Map<string, string>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = tagSlug(tag);
      if (!tagMap.has(slug)) tagMap.set(slug, tag);
    }
  }
  return [...tagMap.entries()].map(([slug, display]) => ({
    params: { tag: slug },
    props: { tag: display, slug },
  }));
}

type Props = { tag: string; slug: string };
const { tag, slug } = Astro.props as Props;

const all = (await getCollection("blog", ({ data }) => !data.draft))
  .filter((p) => p.data.tags.some((t) => tagSlug(t) === slug))
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.publishDate.getTime() - a.data.publishDate.getTime(),
  );

const label = `#${tag}`;
const breadcrumbLd = breadcrumbList([
  { name: "Home", url: SITE.URL },
  { name: "Blog", url: "/blog/" },
  { name: label, url: `/blog/tag/${slug}/` },
]);

const tones = CARD_TONES;

// Below the threshold a tag page is one or two cards of content that
// already live on the post, the category page and the blog index — thin,
// near-duplicate pages that dilute the crawl budget. Keep them reachable
// and followable for humans, but out of the index and out of the sitemap
// (see the sitemap filter in astro.config.mjs, which uses the same rule).
const isThin = all.length < TAG_OG_MIN_POSTS;

// Generated tag card only exists above the threshold; else reuse blog card.
const ogImage = isThin ? "/og/page/blog.png" : `/og/tag/${slug}.png`;

// Every tag in the closed vocabulary carries its own copy. Before this, the
// page rendered the templated string "N posts with this tag." — identical
// across every tag, which is thin regardless of how many posts it listed.
const entry = BLOG_TAGS[slug as BlogTag];

// `related` is a readonly tuple of string literals because BLOG_TAGS is
// declared `as const`, and every literal is a key of BLOG_TAGS. Spreading
// widens it to BlogTag[]. Do NOT reach for a `(t): t is BlogTag` type
// predicate here — the parameter is already the narrow literal union, so
// BlogTag is not assignable to it and TS rejects the predicate.
const relatedTags: BlogTag[] = [...(entry?.related ?? [])];

const collectionLd = collectionPage({
  url: new URL(`/blog/tag/${slug}/`, SITE.URL).href,
  title: `${entry?.label ?? tag} — posts`,
  description: entry?.description ?? `Posts tagged ${label}.`,
  items: all.map((p) => ({
    url: `/blog/${p.id}/`,
    name: p.data.title,
    description: p.data.description,
    datePublished: p.data.publishDate.toISOString(),
  })),
  itemType: "BlogPosting",
});
---

<Page
  title={`${entry?.label ?? tag} — ${all.length} ${all.length === 1 ? "post" : "posts"}`}
  description={entry?.description ?? `${all.length} posts tagged ${label}.`}
  eyebrow={`Tag · ${label}`}
  heading={`${entry?.label ?? tag}.`}
  intro={entry?.description}
  image={ogImage}
  structuredData={[breadcrumbLd, collectionLd]}
  noindex={isThin}
  robots={isThin ? "noindex,follow" : undefined}
>
  <div class="mx-auto max-w-4xl space-y-10 px-5 pb-16">
    <p>
      <a
        href="/blog/"
        class="mono text-accent-text hover:bg-yellow hover:text-ink -mx-1 px-1 text-xs font-bold tracking-widest uppercase"
      >
        ← Back to all posts
      </a>
    </p>

    {
      relatedTags.length > 0 && (
        <nav
          aria-label="Related tags"
          class="flex flex-wrap items-center gap-2"
        >
          <span class="mono text-xs font-bold tracking-widest uppercase opacity-70">
            Related
          </span>
          {relatedTags.map((t) => (
            <a
              href={`/blog/tag/${t}/`}
              class="border-ink hover:bg-yellow hover:text-on-accent rounded-[4px] border-[3px] px-2 py-1 text-xs font-bold"
            >
              #{BLOG_TAGS[t].label}
            </a>
          ))}
        </nav>
      )
    }

    {
      all.length > 0 ? (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {all.map((post, i) => (
            <li class="min-w-0">
              <PostCard
                post={post}
                eager={i < 3}
                tone={tones[i % tones.length]}
              />
            </li>
          ))}
        </ul>
      ) : (
        <div class="border-ink rounded-[4px] border-[3px] border-dashed p-12 text-center">
          <p class="display mb-2 text-3xl">Nothing here yet</p>
          <p class="opacity-70">No posts with {label}.</p>
        </div>
      )
    }
  </div>
</Page>
