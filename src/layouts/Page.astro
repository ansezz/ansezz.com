---
import BaseLayout from "./BaseLayout.astro";
import { webPage } from "@/lib/seo";
import { pageOgPath } from "@/lib/og-pages";
import { SITE } from "@/consts";

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  heading: string;
  intro?: string;
  image?: string;
  structuredData?: object | object[];
  noindex?: boolean;
  robots?: string;
  prev?: string;
  next?: string;
  feeds?: { title: string; href: string }[];
}

const {
  title,
  description,
  eyebrow,
  heading,
  intro,
  image,
  structuredData,
  noindex,
  robots,
  prev,
  next,
  feeds,
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, SITE.URL).href;
const pageDesc = description ?? SITE.DESCRIPTION;
// Per-page branded OG card when the page hasn't supplied its own image.
const resolvedImage = image ?? pageOgPath(Astro.url.pathname) ?? undefined;
const autoWebPage = noindex
  ? null
  : webPage({
      url: pageUrl,
      title,
      description: pageDesc,
      image: resolvedImage,
    });

const extra = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const finalStructured = autoWebPage ? [autoWebPage, ...extra] : extra;
---

<BaseLayout
  title={title}
  description={description}
  image={resolvedImage}
  structuredData={finalStructured}
  noindex={noindex}
  robots={robots}
  prev={prev}
  next={next}
  feeds={feeds}
>
  <section
    class="relative mx-auto max-w-5xl px-5 pt-12 pb-10 md:pt-20 md:pb-14"
  >
    {
      eyebrow && (
        <p class="mono text-accent-text mb-4 text-sm font-bold tracking-widest uppercase">
          ▸ {eyebrow}
        </p>
      )
    }
    <h1 class="display max-w-5xl text-[clamp(2rem,5.5vw,4rem)]">
      {heading}
    </h1>
    {
      intro && (
        <p class="text-ink/80 mt-5 max-w-2xl text-base leading-snug sm:text-lg md:text-xl">
          {intro}
        </p>
      )
    }
  </section>
  <slot />
</BaseLayout>
