{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/about/index.html",
        "http://localhost/work/index.html",
        "http://localhost/services/index.html",
        "http://localhost/blog/index.html",
        "http://localhost/blog/scaling-with-rabbitmq/index.html",
        "http://localhost/blog/series/rag-in-production/index.html",
        "http://localhost/tools/index.html",
        "http://localhost/tools/jwt-decoder/index.html",
        "http://localhost/contact/index.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "csp-xss": "off",
        "unused-javascript": "off",
        "unused-css-rules": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
